[Unit]
Description=Vectis off-host backup sync to Cloudflare R2
Documentation=file:///opt/vectis/deploy/offhost-backup/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Backup archives under /var/vectis/backups are root-owned (written by the
# in-container scheduler running as root), so the sync runs as root.
EnvironmentFile=/etc/vectis/r2-backup.env
ExecStart=/usr/bin/python3 /usr/local/bin/vectis-r2-backup-sync.py
Nice=10
