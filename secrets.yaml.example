# Vectis Mail Server Secrets
# Copy this to /etc/vectis/secrets.yaml (mode 0600)
# NEVER commit real secrets to git

# PostgreSQL database credentials.
# Vectis uses three dedicated database users (per ADR-019) to enforce
# least-privilege access from each service.
database:
  host: postgres
  port: 5432
  name: vectis
  # Superuser password — used only by the postgres container itself
  # (POSTGRES_PASSWORD) and the bootstrap script that creates the three
  # least-privilege users below. Never used by application code.
  superuser_password: "CHANGE_ME_superuser_password"
  api_user: vectis_api
  api_password: "CHANGE_ME_api_password"
  postfix_user: vectis_postfix
  postfix_password: "CHANGE_ME_postfix_password"
  dovecot_user: vectis_dovecot
  dovecot_password: "CHANGE_ME_dovecot_password"

# Valkey (Redis-compatible) key-value store.
valkey:
  host: valkey
  port: 6379
  password: "CHANGE_ME_valkey_password"

# API server secrets.
# secret — used for cookie/JWT signing; must be at least 32 characters.
# admin_email / admin_password — initial admin account seeded by installer.
# backup_encryption_key — AES-256 key for encrypting backup archives.
api:
  secret: "CHANGE_ME_at_least_32_characters_long_random_string"
  admin_email: admin@example.com
  admin_password: "CHANGE_ME_admin_password"
  backup_encryption_key: "CHANGE_ME_backup_key"

# Orchestrator bearer token for internal API-to-orchestrator HTTP calls.
orchestrator:
  token: "CHANGE_ME_orchestrator_bearer_token"

# DKIM signing key storage path.
dkim:
  key_base_path: /var/vectis/dkim

# ValidonX licensing — leave empty for Free tier (the default).
# Pro/Enterprise customers receive a subscription_id from validonx.com after
# checkout. Recommended path: leave this block empty here, then activate via
# the admin UI License page after install (the values are persisted to the
# validonx_config DB table, which takes precedence over this file). For
# air-gapped or scripted deploys, populate the fields below at install time.
#
# - base_url: ValidonX API endpoint (defaults to https://api.validonx.com)
# - service_key: per-install authentication key issued by ValidonX
# - tenant_id: customer tenant ID
# - subscription_id: this server's active subscription
# - server_id: unique identifier for this server (defaults to hostname)
validonx:
  base_url: ""
  service_key: ""
  tenant_id: ""
  subscription_id: ""
  server_id: ""

# Note: the `cloudflare` block accepted by pre-rc27 installs is now ignored.
# TLS certs are issued by Traefik and mirrored into the mail-certs volume by
# the cert-extractor sidecar, so no ACME client credentials are needed here.
