# Vectis Mail Server Configuration
# Copy this to /etc/vectis/config.yaml and edit for your server

# The fully-qualified hostname clients use to reach this mail server.
# Must have a valid DNS A/AAAA record and matching MX record.
hostname: mail.example.com

# TLS certificate provisioning.
tls:
  provider: letsencrypt    # letsencrypt or custom
  email: admin@example.com # Required for Let's Encrypt ACME account
  # Uncomment for provider: custom (bring your own certificate)
  # cert_path: /etc/vectis/tls/fullchain.pem
  # key_path:  /etc/vectis/tls/privkey.pem

# Container resource-limit profile.
# Picks per-container `mem_limit` ceilings (P7-H1 / audit 2026-05-17).
# Limits are HARD cgroup ceilings — a service exceeding its limit gets
# OOM-killed by the container's cgroup rather than crashing the host.
#
#   dev        — laptop / 2 GB VPS; ~1.8 GB base ceiling
#   small      — single-domain 4 GB VPS; ~3.5 GB base ceiling  (default)
#   production — multi-domain 8 GB VPS; ~6.7 GB base ceiling
#   enterprise — high-volume 16 GB+; ~13.5 GB base ceiling
#
# "Base" excludes the optional webmail / Loki+Promtail+Grafana / ClamAV /
# cert-extractor / pgbouncer services — each adds its own profile-scaled
# ceiling. See the RAM-vs-feature matrix in the installation docs.
resources:
  profile: small           # dev, small, production, enterprise

# ClamAV antivirus sidecar.
# Set to "none" to omit the ClamAV container entirely, saving ~1 GB RAM.
# Otherwise the profile follows the same tiers as resources above.
clamav:
  profile: none            # none, dev, small, production, enterprise

# Rspamd spam-filtering thresholds.
# spam_threshold  — score at which a message is flagged as spam
# reject_threshold — score at which a message is rejected outright
#                    (999 = effectively disabled; recommended until tuned)
# greylist_enabled — whether to enable greylisting for unknown senders
rspamd:
  spam_threshold: 15.0
  reject_threshold: 999    # 999 = effectively disabled
  greylist_enabled: false

# Postfix MTA settings.
postfix:
  message_size_limit: 52428800  # 50 MB in bytes
  smtp_banner: "$myhostname ESMTP"

# Dovecot IMAP / LDA settings.
dovecot:
  mail_location: "maildir:/var/vectis/mail/%d/%n/Maildir"
  quota_default_mb: 1024   # 1 GB default per-mailbox quota

# Periodic backup configuration.
backup:
  enabled: false
  schedule: "0 2 * * *"    # Cron expression — 2 AM daily
  retain_days: 30

# Container logging driver and rotation.
logging:
  level: info              # debug, info, warn, error
  driver: json-file        # Docker log driver
  max_size_mb: 50
  max_files: 5

# Administrative HTTP interface (the Vectis web UI / API).
admin:
  listen_addr: ":8080"
  session_ttl_hours: 24

# Update orchestrator timeouts (Phase 1).
orchestrator:
  image_pull_timeout: 300    # seconds per image (ClamAV ~1 GB needs longer)
  health_check_timeout: 120  # seconds per service
  db_migration_timeout: 60   # seconds total
  apply_timeout: 600         # seconds total for full apply cycle

# Traefik rate limiting (per-client IP, via Traefik middleware).
# Rates are requests per second with a burst allowance.
rate_limits:
  auth_average: 10         # login/logout endpoints
  auth_burst: 20
  api_average: 50          # general API reads (GET)
  api_burst: 100
  mutate_average: 20       # mutating endpoints (POST/PATCH/DELETE)
  mutate_burst: 40

# Alerting configuration (Phase 1).
# Alerts are sent when services fail, disks fill, certs expire, etc.
#
# Email is OFF by default — on a fresh install the api container has no
# local SMTP listener, and turning this on without setting smtp_host to
# a reachable relay would fail silently. To enable:
#   1. Set enabled: true
#   2. Set smtp_host to a reachable SMTP server. Using the bundled Postfix
#      (`vectis-postfix:25`) works only if you also allow relay from the
#      vectis-data subnet in the Postfix mynetworks directive.
#   3. Leave recipients empty to fall back to secrets.yaml api.admin_email,
#      or list explicit addresses to override.
alerts:
  email:
    enabled: false
    smtp_host: ""            # e.g. "vectis-postfix:25" or "smtp.external.example:587"
    recipients: []           # empty → falls back to secrets.yaml api.admin_email
  webhook:
    enabled: false
    url: ""                  # e.g. https://hooks.slack.com/services/...
