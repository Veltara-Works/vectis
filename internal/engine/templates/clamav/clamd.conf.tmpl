# Vectis Mail Server — ClamAV daemon configuration
# Generated by config engine — do not edit manually
#
# Profile: {{ .ClamAV.Profile }}
# (knobs scaled per ADR-007 — adjust by changing clamav.profile in config.yaml)

LogFile /var/log/clamav/clamd.log
LogTime yes
LogClean no
LogVerbose no
LogSyslog no

PidFile /var/run/clamav/clamd.pid
DatabaseDirectory /var/lib/clamav
LocalSocket /var/run/clamav/clamd.sock
LocalSocketMode 660
FixStaleSocket yes

# TCP listener — rspamd connects from vectis-mail. 0.0.0.0 is safe inside
# the bridge network; external access is blocked by Docker not publishing
# port 3310 to the host.
TCPSocket 3310
TCPAddr 0.0.0.0

User clamav

# Scan settings — mail-focused defaults.
ScanMail yes
ScanArchive yes
ScanPE yes
ScanELF yes
ScanOLE2 yes
ScanPDF yes
ScanHTML yes

# Per-profile resource knobs (resolved by config engine from clamav.profile).
# Each is emitted only when the resolved profile actually sets it. A bare
# directive with no argument (e.g. `StreamMaxLength ` under profile "none",
# whose knobs are zero-valued) is a fatal clamd parse error — so when a knob
# is unset we omit the line and let clamd fall back to its built-in default
# rather than render an unparseable config (#44).
{{- if .ClamAV.MaxThreads }}
MaxThreads {{ .ClamAV.MaxThreads }}
{{- end }}
MaxConnectionQueueLength 30
{{- if .ClamAV.StreamMaxLength }}
StreamMaxLength {{ .ClamAV.StreamMaxLength }}
{{- end }}
{{- if .ClamAV.MaxScanSize }}
MaxScanSize {{ .ClamAV.MaxScanSize }}
{{- end }}
{{- if .ClamAV.MaxFileSize }}
MaxFileSize {{ .ClamAV.MaxFileSize }}
{{- end }}

# Re-check signatures every 10 min — freshclam in the entrypoint refreshes
# the on-disk DB; SelfCheck makes clamd reload them in-process without a
# container restart.
SelfCheck 600

# Reload the signature DB in place rather than building a second copy alongside
# the live one. The default (yes) briefly holds two full ~1 GB databases in
# memory during a reload, which spiked clamd over its cgroup mem_limit and got
# it OOM-killed on the mx1 canary (2026-07-05). In-place reload roughly halves
# the reload peak; the cost is a sub-second window where clamd can't scan, which
# rspamd's antivirus module fails open on (no CLAM_VIRUS symbol → no reject), so
# no mail is bounced during the daily freshclam update.
ConcurrentDatabaseReload no
