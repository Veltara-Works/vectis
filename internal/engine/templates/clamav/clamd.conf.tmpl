# Vectis Mail Server — ClamAV daemon configuration
# Generated by config engine — do not edit manually
#
# Profile: {{ .ClamAV.Profile }}
# (knobs scaled per ADR-007 — adjust by changing clamav.profile in config.yaml)

LogFile /var/log/clamav/clamd.log
LogTime yes
LogClean no
LogVerbose no
LogSyslog no

PidFile /var/run/clamav/clamd.pid
DatabaseDirectory /var/lib/clamav
LocalSocket /var/run/clamav/clamd.sock
LocalSocketMode 660
FixStaleSocket yes

# TCP listener — rspamd connects from vectis-mail. 0.0.0.0 is safe inside
# the bridge network; external access is blocked by Docker not publishing
# port 3310 to the host.
TCPSocket 3310
TCPAddr 0.0.0.0

User clamav

# Scan settings — mail-focused defaults.
ScanMail yes
ScanArchive yes
ScanPE yes
ScanELF yes
ScanOLE2 yes
ScanPDF yes
ScanHTML yes

# Per-profile resource knobs (resolved by config engine from clamav.profile).
MaxThreads {{ .ClamAV.MaxThreads }}
MaxConnectionQueueLength 30
StreamMaxLength {{ .ClamAV.StreamMaxLength }}
MaxScanSize {{ .ClamAV.MaxScanSize }}
MaxFileSize {{ .ClamAV.MaxFileSize }}

# Re-check signatures every 10 min — freshclam in the entrypoint refreshes
# the on-disk DB; SelfCheck makes clamd reload them in-process without a
# container restart.
SelfCheck 600
