#!/bin/sh
# Vectis Mail Server — acme.sh mail certificate issuance/renewal
# Generated by config engine — do not edit manually
#
# This script runs inside the acme.sh sidecar container.
# It issues a certificate for the mail hostname and deploys it
# to the shared mail-certs volume.

set -e

DOMAIN="{{ .Hostname }}"
CERT_DIR="/etc/ssl/mail"

echo "[vectis-acme] Requesting certificate for ${DOMAIN}"

{{ if eq .TLS.Provider "letsencrypt" }}
# Issue cert via HTTP-01 challenge (standalone mode).
# The acme.sh container must have port 80 accessible or use DNS-01.
acme.sh --issue \
    --domain "${DOMAIN}" \
    --standalone \
    --keylength 2048 \
    --server letsencrypt \
    || true  # Don't fail if cert already exists

# Install cert to the mail cert directory.
acme.sh --install-cert \
    --domain "${DOMAIN}" \
    --fullchain-file "${CERT_DIR}/fullchain.pem" \
    --key-file "${CERT_DIR}/privkey.pem" \
    --reloadcmd "echo '[vectis-acme] Cert installed to ${CERT_DIR}'"
{{ end }}

echo "[vectis-acme] Certificate ready at ${CERT_DIR}"
