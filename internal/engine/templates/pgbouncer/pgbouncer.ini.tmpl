; Vectis Mail Server — PgBouncer Configuration
; Generated by config engine — do not edit manually
;
; PgBouncer connection pooler for high-traffic multi-node deployments.
; Sits between Postfix/Dovecot/API and Postgres to reduce connection overhead.

[databases]
; Main database — routes to the Postgres server.
{{ .Database.Name }} = host={{ .Database.Host }} port={{ .Database.Port }} dbname={{ .Database.Name }}

[pgbouncer]
listen_addr = 0.0.0.0
listen_port = {{ if .Cluster.PgBouncer.ListenPort }}{{ .Cluster.PgBouncer.ListenPort }}{{ else }}6432{{ end }}

; Authentication — use the same credentials as direct Postgres connections.
auth_type = md5
auth_file = /etc/pgbouncer/userlist.txt

; Pool mode: "transaction" is best for Postfix/Dovecot SQL lookups (short queries).
pool_mode = {{ if .Cluster.PgBouncer.PoolMode }}{{ .Cluster.PgBouncer.PoolMode }}{{ else }}transaction{{ end }}

; Pool sizing.
default_pool_size = {{ if .Cluster.PgBouncer.DefaultPoolSize }}{{ .Cluster.PgBouncer.DefaultPoolSize }}{{ else }}20{{ end }}
max_client_conn = {{ if .Cluster.PgBouncer.MaxClientConn }}{{ .Cluster.PgBouncer.MaxClientConn }}{{ else }}200{{ end }}
min_pool_size = 5
reserve_pool_size = 5
reserve_pool_timeout = 3

; Timeouts.
server_connect_timeout = 5
server_idle_timeout = 600
server_lifetime = 3600
query_timeout = 30
query_wait_timeout = 60

; Logging.
log_connections = 0
log_disconnections = 0
log_pooler_errors = 1
stats_period = 60

; Admin console.
admin_users = {{ .Database.APIUser }}
