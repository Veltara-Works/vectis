# Vectis Mail Server — Production Docker Compose
# Generated by config engine — do not edit manually

services:
  traefik:
    image: traefik:v3.3
    container_name: vectis-traefik
    restart: unless-stopped
    networks:
      - vectis-frontend
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - traefik-config:/etc/traefik:ro
      - traefik-acme:/etc/traefik/acme
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping"]
      interval: 10s
      timeout: 5s
      retries: 3
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  api:
    image: ghcr.io/veltara-works/vectis-api:{{ .Version }}
    container_name: vectis-api
    restart: unless-stopped
    networks:
      - vectis-frontend
      - vectis-data
      - vectis-orchestrator
    volumes:
      - /etc/vectis:/etc/vectis:ro
      - mail-data:/var/vectis/mail
      - dkim-keys:/var/vectis/dkim
      - postfix-logs:/var/log/postfix:ro
    depends_on:
      postgres:
        condition: service_healthy
      valkey:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null http://localhost:8080/api/v1/health"]
      interval: 10s
      timeout: 5s
      retries: 3
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  orchestrator:
    image: ghcr.io/veltara-works/vectis-orchestrator:{{ .Version }}
    container_name: vectis-orchestrator
    restart: unless-stopped
    networks:
      - vectis-orchestrator
      - vectis-data
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /etc/vectis:/etc/vectis:ro
      - snapshots:/var/vectis/snapshots
    depends_on:
      postgres:
        condition: service_healthy
      valkey:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null http://localhost:8081/internal/health"]
      interval: 10s
      timeout: 5s
      retries: 3
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  postfix:
    image: ghcr.io/veltara-works/vectis-postfix:{{ .Version }}
    container_name: vectis-postfix
    restart: unless-stopped
    hostname: {{ .Hostname }}
    networks:
      - vectis-mail
      - vectis-data
    ports:
      - "25:25"
      - "465:465"
      - "587:587"
    volumes:
      - postfix-config:/etc/postfix
      - mail-data:/var/vectis/mail
      - mail-certs:/etc/ssl/mail:ro
      - postfix-logs:/var/log/postfix
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "postfix status || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  dovecot:
    image: ghcr.io/veltara-works/vectis-dovecot:{{ .Version }}
    container_name: vectis-dovecot
    restart: unless-stopped
    networks:
      - vectis-mail
      - vectis-data
    ports:
      - "993:993"
      - "995:995"
    volumes:
      - dovecot-config:/etc/dovecot
      - mail-data:/var/vectis/mail
      - mail-certs:/etc/ssl/mail:ro
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "doveadm", "service", "status"]
      interval: 30s
      timeout: 10s
      retries: 3
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  rspamd:
    image: ghcr.io/veltara-works/vectis-rspamd:{{ .Version }}
    container_name: vectis-rspamd
    restart: unless-stopped
    networks:
      - vectis-mail
      - vectis-data
    volumes:
      - rspamd-config:/etc/rspamd/local.d
      - dkim-keys:/var/vectis/dkim:ro
    depends_on:
      valkey:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "rspamadm", "control", "stat"]
      interval: 30s
      timeout: 10s
      retries: 3
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"
{{ if .Webmail.Enabled }}
  webmail:
    image: roundcube/roundcubemail:latest-fpm-alpine
    container_name: vectis-webmail
    restart: unless-stopped
    networks:
      - vectis-frontend
      - vectis-mail
    volumes:
      - webmail-config:/var/roundcube/config:ro
      - webmail-data:/var/roundcube/db
      - webmail-skin:/var/roundcube/skins/vectis:ro
    environment:
      ROUNDCUBEMAIL_DEFAULT_HOST: "ssl://vectis-dovecot"
      ROUNDCUBEMAIL_DEFAULT_PORT: "993"
      ROUNDCUBEMAIL_SMTP_SERVER: "tls://vectis-postfix"
      ROUNDCUBEMAIL_SMTP_PORT: "587"
      ROUNDCUBEMAIL_DB_TYPE: "sqlite"
      ROUNDCUBEMAIL_UPLOAD_MAX_FILESIZE: "{{ if .Webmail.UploadMaxMB }}{{ .Webmail.UploadMaxMB }}{{ else }}25{{ end }}M"
      ROUNDCUBEMAIL_SKIN: "elastic"
      ROUNDCUBEMAIL_PLUGINS: "archive,managesieve,zipdownload"
    depends_on:
      dovecot:
        condition: service_healthy
      postfix:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "php-fpm-healthcheck || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  webmail-nginx:
    image: nginx:alpine
    container_name: vectis-webmail-nginx
    restart: unless-stopped
    networks:
      - vectis-frontend
    volumes:
      - webmail-nginx-config:/etc/nginx/conf.d:ro
    depends_on:
      - webmail
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"
{{ end }}
{{ if .Observability.LokiEnabled }}
  loki:
    image: grafana/loki:3.4
    container_name: vectis-loki
    restart: unless-stopped
    networks:
      - vectis-data
    command: -config.file=/etc/loki/loki.yml
    volumes:
      - loki-config:/etc/loki:ro
      - loki-data:/loki
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null http://localhost:3100/ready"]
      interval: 15s
      timeout: 5s
      retries: 3
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  promtail:
    image: grafana/promtail:3.4
    container_name: vectis-promtail
    restart: unless-stopped
    networks:
      - vectis-data
    command: -config.file=/etc/promtail/promtail.yml
    volumes:
      - promtail-config:/etc/promtail:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
    depends_on:
      loki:
        condition: service_healthy
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"
{{ end }}
{{ if .Observability.GrafanaEnabled }}
  grafana:
    image: grafana/grafana:11.5
    container_name: vectis-grafana
    restart: unless-stopped
    networks:
      - vectis-frontend
      - vectis-data
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD__FILE: /run/secrets/grafana_admin_password
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_SERVER_ROOT_URL: "https://{{ .Hostname }}/grafana/"
      GF_SERVER_SERVE_FROM_SUB_PATH: "true"
    secrets:
      - grafana_admin_password
    volumes:
      - grafana-data:/var/lib/grafana
    depends_on:
      api:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null http://localhost:3000/api/health"]
      interval: 15s
      timeout: 5s
      retries: 3
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"
{{ end }}
{{ if ne .ClamAV.Profile "none" }}
  clamav:
    image: ghcr.io/veltara-works/vectis-clamav:{{ .Version }}
    container_name: vectis-clamav
    restart: unless-stopped
    networks:
      - vectis-mail
    healthcheck:
      test: ["CMD", "clamdcheck"]
      interval: 60s
      timeout: 30s
      retries: 3
      start_period: 120s
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"
{{ end }}
  acme-sh:
    image: neilpang/acme.sh:latest
    container_name: vectis-acme
    restart: unless-stopped
    networks:
      - vectis-frontend
    environment:
      DEPLOY_DOCKER_CONTAINER_LABEL: "vectis-mail-certs"
      DEPLOY_DOCKER_CONTAINER_RELOAD_CMD: "true"
{{ if .Cloudflare }}
    secrets:
      - cloudflare_token
{{ end }}
    volumes:
      - acme-data:/acme.sh
      - mail-certs:/etc/ssl/mail
    entrypoint: /bin/sh
    command:
      - -c
      - |
{{ if .Cloudflare }}
        export CF_Token="$(cat /run/secrets/cloudflare_token)"
        acme.sh --issue --dns dns_cf -d {{ .Hostname }} --keylength 2048 || true
{{ else }}
        acme.sh --issue --standalone -d {{ .Hostname }} --keylength 2048 --httpport 80 || true
{{ end }}
        acme.sh --install-cert -d {{ .Hostname }} \
          --cert-file /etc/ssl/mail/cert.pem \
          --key-file /etc/ssl/mail/privkey.pem \
          --fullchain-file /etc/ssl/mail/fullchain.pem || true
        exec acme.sh --cron --home /acme.sh
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  postgres:
    image: postgres:17-alpine
    container_name: vectis-postgres
    restart: unless-stopped
    networks:
      - vectis-data
    # Bind to loopback only so the host-side `vectis` binary can run
    # migrations against `127.0.0.1:5432` without exposing Postgres to
    # the public interface. In-container clients still reach it as
    # `postgres:5432` over the vectis-data network.
    ports:
      - "127.0.0.1:5432:5432"
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: "{{ .Database.SuperuserPassword }}"
      POSTGRES_DB: "{{ .Database.Name }}"
      VECTIS_API_PASSWORD: "{{ .Database.APIPassword }}"
      VECTIS_POSTFIX_PASSWORD: "{{ .Database.PostfixPassword }}"
      VECTIS_DOVECOT_PASSWORD: "{{ .Database.DovecotPassword }}"
    volumes:
      - pgdata:/var/lib/postgresql/data
      - /var/vectis/generated/postgres/init-users.sh:/docker-entrypoint-initdb.d/01-init-users.sh:ro
    # Healthcheck must hit TCP, not the unix socket: during first-start
    # postgres runs init scripts against a temp server bound only to the
    # socket, so a socket-only `pg_isready` reports healthy before the
    # 5432 listener is up. Forcing -h 127.0.0.1 ensures the host-side
    # migration step in `vectis install` can actually connect.
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -p 5432 -U postgres -d {{ .Database.Name }}"]
      interval: 5s
      timeout: 5s
      retries: 20
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"
{{ if .Cluster.PgBouncer.Enabled }}
  pgbouncer:
    image: edoburu/pgbouncer:1.23.1-p2
    container_name: vectis-pgbouncer
    restart: unless-stopped
    networks:
      - vectis-data
    volumes:
      - pgbouncer-config:/etc/pgbouncer:ro
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h localhost -p {{ if .Cluster.PgBouncer.ListenPort }}{{ .Cluster.PgBouncer.ListenPort }}{{ else }}6432{{ end }}"]
      interval: 10s
      timeout: 5s
      retries: 3
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"
{{ end }}
  valkey:
    image: valkey/valkey:8-alpine
    container_name: vectis-valkey
    restart: unless-stopped
    networks:
      - vectis-data
    entrypoint: ["sh", "-c"]
    command:
      - |
        exec valkey-server \
          --requirepass "$$(cat /run/secrets/valkey_password)" \
          --save 60 1000 \
          --save 300 100{{ if .Cluster.Enabled }} \
          --min-replicas-to-write 0 \
          --min-replicas-max-lag 10{{ end }}
    secrets:
      - valkey_password
    volumes:
      - valkeydata:/data
    healthcheck:
      test: ["CMD-SHELL", "valkey-cli -a \"$$(cat /run/secrets/valkey_password)\" ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

networks:
  vectis-frontend:
    driver: {{ if .Cluster.Enabled }}overlay{{ else }}bridge{{ end }}
    internal: false
  vectis-mail:
    driver: {{ if .Cluster.Enabled }}overlay{{ else }}bridge{{ end }}
    internal: true
  vectis-data:
    driver: {{ if .Cluster.Enabled }}overlay{{ else }}bridge{{ end }}
    internal: true
  vectis-orchestrator:
    driver: {{ if .Cluster.Enabled }}overlay{{ else }}bridge{{ end }}
    internal: true

volumes:
  pgdata:
  valkeydata:
  mail-data:
  mail-certs:
  dkim-keys:
  postfix-config:
  postfix-logs:
  dovecot-config:
  rspamd-config:
  traefik-config:
  traefik-acme:
  acme-data:
  snapshots:
{{ if .Cluster.PgBouncer.Enabled }}
  pgbouncer-config:
{{ end }}
{{ if .Observability.GrafanaEnabled }}
  grafana-data:
{{ end }}
{{ if .Webmail.Enabled }}
  webmail-config:
  webmail-data:
  webmail-skin:
  webmail-nginx-config:
{{ end }}
{{ if .Observability.LokiEnabled }}
  loki-config:
  loki-data:
  promtail-config:
{{ end }}

secrets:
  valkey_password:
    file: /var/vectis/generated/secrets/valkey_password
{{ if .Cloudflare }}
  cloudflare_token:
    file: /var/vectis/generated/secrets/cloudflare_token
{{ end }}
{{ if .Observability.GrafanaEnabled }}
  grafana_admin_password:
    file: /var/vectis/generated/secrets/grafana_admin_password
{{ end }}
