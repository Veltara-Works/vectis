# Vectis Mail Server — Production Docker Compose
# Generated by config engine — do not edit manually

services:
  traefik:
    image: traefik:v3.3
    container_name: vectis-traefik
    restart: unless-stopped
    networks:
      - vectis-frontend
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - traefik-config:/etc/traefik:ro
      - traefik-acme:/etc/traefik/acme
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping"]
      interval: 10s
      timeout: 5s
      retries: 3
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  api:
    image: ghcr.io/veltara-works/vectis-api:latest
    container_name: vectis-api
    restart: unless-stopped
    networks:
      - vectis-frontend
      - vectis-data
      - vectis-orchestrator
    volumes:
      - /etc/vectis:/etc/vectis:ro
      - mail-data:/var/vectis/mail
      - dkim-keys:/var/vectis/dkim
    depends_on:
      postgres:
        condition: service_healthy
      valkey:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null http://localhost:8080/api/v1/health"]
      interval: 10s
      timeout: 5s
      retries: 3
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  orchestrator:
    image: ghcr.io/veltara-works/vectis-orchestrator:latest
    container_name: vectis-orchestrator
    restart: unless-stopped
    networks:
      - vectis-orchestrator
      - vectis-data
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /etc/vectis:/etc/vectis:ro
      - snapshots:/var/vectis/snapshots
    depends_on:
      postgres:
        condition: service_healthy
      valkey:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null http://localhost:8081/internal/health"]
      interval: 10s
      timeout: 5s
      retries: 3
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  postfix:
    image: ghcr.io/veltara-works/vectis-postfix:latest
    container_name: vectis-postfix
    restart: unless-stopped
    hostname: {{ .Hostname }}
    networks:
      - vectis-mail
      - vectis-data
    ports:
      - "25:25"
      - "465:465"
      - "587:587"
    volumes:
      - postfix-config:/etc/postfix
      - mail-data:/var/vectis/mail
      - mail-certs:/etc/ssl/mail:ro
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "postfix status || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  dovecot:
    image: ghcr.io/veltara-works/vectis-dovecot:latest
    container_name: vectis-dovecot
    restart: unless-stopped
    networks:
      - vectis-mail
      - vectis-data
    ports:
      - "993:993"
      - "995:995"
    volumes:
      - dovecot-config:/etc/dovecot
      - mail-data:/var/vectis/mail
      - mail-certs:/etc/ssl/mail:ro
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "doveadm", "service", "status"]
      interval: 30s
      timeout: 10s
      retries: 3
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  rspamd:
    image: ghcr.io/veltara-works/vectis-rspamd:latest
    container_name: vectis-rspamd
    restart: unless-stopped
    networks:
      - vectis-mail
      - vectis-data
    volumes:
      - rspamd-config:/etc/rspamd/local.d
      - dkim-keys:/var/vectis/dkim:ro
    depends_on:
      valkey:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "rspamadm", "control", "stat"]
      interval: 30s
      timeout: 10s
      retries: 3
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"
{{ if ne .ClamAV.Profile "none" }}
  clamav:
    image: ghcr.io/veltara-works/vectis-clamav:latest
    container_name: vectis-clamav
    restart: unless-stopped
    networks:
      - vectis-mail
    healthcheck:
      test: ["CMD", "clamdcheck"]
      interval: 60s
      timeout: 30s
      retries: 3
      start_period: 120s
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"
{{ end }}
  acme-sh:
    image: neilpang/acme.sh:latest
    container_name: vectis-acme
    restart: unless-stopped
    networks:
      - vectis-frontend
    environment:
      DEPLOY_DOCKER_CONTAINER_LABEL: "vectis-mail-certs"
      DEPLOY_DOCKER_CONTAINER_RELOAD_CMD: "true"
{{ if .Cloudflare }}
      CF_Token: {{ .Cloudflare.APIToken }}
{{ end }}
    volumes:
      - acme-data:/acme.sh
      - mail-certs:/etc/ssl/mail
    entrypoint: /bin/sh
    command:
      - -c
      - |
{{ if .Cloudflare }}
        acme.sh --issue --dns dns_cf -d {{ .Hostname }} --keylength 2048 || true
{{ else }}
        acme.sh --issue --standalone -d {{ .Hostname }} --keylength 2048 --httpport 80 || true
{{ end }}
        acme.sh --install-cert -d {{ .Hostname }} \
          --cert-file /etc/ssl/mail/cert.pem \
          --key-file /etc/ssl/mail/privkey.pem \
          --fullchain-file /etc/ssl/mail/fullchain.pem || true
        exec acme.sh --cron --home /acme.sh
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  postgres:
    image: postgres:17-alpine
    container_name: vectis-postgres
    restart: unless-stopped
    networks:
      - vectis-data
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{ .Database.Name }}"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  valkey:
    image: valkey/valkey:8-alpine
    container_name: vectis-valkey
    restart: unless-stopped
    networks:
      - vectis-data
    command: valkey-server --requirepass {{ .Valkey.Password }}
    environment:
      VALKEY_PASSWORD: {{ .Valkey.Password }}
    volumes:
      - valkeydata:/data
    healthcheck:
      test: ["CMD-SHELL", "valkey-cli -a $$VALKEY_PASSWORD ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

networks:
  vectis-frontend:
    driver: bridge
    internal: false
  vectis-mail:
    driver: bridge
    internal: true
  vectis-data:
    driver: bridge
    internal: true
  vectis-orchestrator:
    driver: bridge
    internal: true

volumes:
  pgdata:
  valkeydata:
  mail-data:
  mail-certs:
  dkim-keys:
  postfix-config:
  dovecot-config:
  rspamd-config:
  traefik-config:
  traefik-acme:
  acme-data:
  snapshots:
