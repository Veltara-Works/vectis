# Vectis Mail Server — Production Docker Compose
# Generated by config engine — do not edit manually

services:
  # Named volumes are intentionally NOT used for service configs — the
  # generated configs live on the host under /var/vectis/generated/<svc>/
  # and must be bind-mounted into each container. Named volumes start
  # empty on first create and would shadow the image's defaults without
  # surfacing our config, leaving traefik/postfix/dovecot/rspamd running
  # vanilla out-of-the-box configuration. Always mirror any new generated
  # file here as a bind mount (see docker-compose.mail.yml for reference).

  traefik:
    image: traefik:v3.3
    container_name: vectis-traefik
    restart: unless-stopped
    networks:
      - vectis-frontend
    # P7-H1 capacity ceiling — resolved from resources.profile in config.yaml
    # (dev / small / production / enterprise). See engine.go ResourceKnobs
    # for the full matrix. Reverse proxy footprint is small; static-config
    # routing only (no plugins). If you've bolted on Traefik plugins or
    # expect >1k rps, bump to a larger profile.
    mem_limit: {{ .Resources.TraefikMemLimit }}
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /var/vectis/generated/traefik/traefik.yml:/etc/traefik/traefik.yml:ro
      - /var/vectis/generated/traefik/dynamic.yml:/etc/traefik/dynamic/dynamic.yml:ro
      - traefik-acme:/var/traefik/acme
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping"]
      interval: 10s
      timeout: 5s
      retries: 3
      # start_period keeps boot-time probe failures from tripping
      # "unhealthy" before the service is ready — the orchestrator's
      # WaitHealthy aborts the rollout the instant a container reports
      # unhealthy, so every healthcheck needs a start grace window.
      start_period: 10s
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  api:
    image: ghcr.io/veltara-works/vectis-api:{{ .Version }}
    container_name: vectis-api
    restart: unless-stopped
    networks:
      - vectis-frontend
      - vectis-data
      - vectis-orchestrator
    # 8080 = HTTP API/UI (fronted by traefik). 10099 = Postfix submission
    # access-policy server (internal only, reached by postfix over vectis-data
    # as `vectis-api:10099`); enforces per-mailbox send-suspend + abuse
    # rate-limit on 587/465. Neither is published to the host.
    expose:
      - "8080"
      - "10099"
    # P7-H1 capacity ceiling — see engine.go ResourceKnobs for the matrix.
    # Go binary; baseline ~80 MB. The `small` default (512m) covers typical
    # request bursts; `production`+ leave headroom for full-Maildir scans +
    # multipart parsing on the send path and large /abuse/dashboard queries.
    mem_limit: {{ .Resources.APIMemLimit }}
    volumes:
      - /etc/vectis:/etc/vectis:ro
      - mail-data:/var/vectis/mail
      # DKIM keys bind-mount from the host (NOT a named volume): the host CLI
      # `vectis domain add` writes keys to the host /var/vectis/dkim and the api
      # writes here too — a named volume hides host-written keys from rspamd, so
      # outbound goes unsigned. See feedback_named_volumes_hide_configs.
      - /var/vectis/dkim:/var/vectis/dkim
      - postfix-logs:/var/log/postfix:ro
      # Advanced Spam (Pro): api writes per-domain rspamd settings + spam-list
      # map files here; rspamd reads them via its own bind mounts on the same
      # path. RW for api so regenerateRspamdSpamConfig can rewrite atomically.
      - /var/vectis/generated/rspamd:/var/vectis/generated/rspamd
      # Backups MUST persist on the host: without this bind they land on the
      # container's ephemeral layer and are destroyed by every cutover's
      # compose down/up. Host path matches the DR runbook §8 + off-host rsync
      # (§5). See docs/notes/dr-drill-2026-05-30.md (finding F1).
      - /var/vectis/backups:/var/vectis/backups
      # License JWKS cache MUST persist on the host: the offline license
      # verifier write-throughs a successful live JWKS fetch here so an
      # air-gapped restart re-resolves from a fresh cache rather than the
      # (possibly older) embedded key. Without this bind it lands on the
      # container's ephemeral layer and is lost on every cutover, leaving the
      # cache layer dead. See DefaultJWKSCachePath in internal/config/schema.go.
      - /var/vectis/license:/var/vectis/license
    depends_on:
      postgres:
        condition: service_healthy
      valkey:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null http://localhost:8080/api/v1/health"]
      interval: 5s
      timeout: 5s
      retries: 3
      # API opens its DB/valkey pools on startup; the grace keeps those
      # early misses out of the failure count. Kept under the per-service
      # window — ServiceHealthTimeouts["api"] = 30s, NOT the 120s default —
      # so a genuinely failed start still surfaces as unhealthy in time.
      start_period: 15s
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  orchestrator:
    image: ghcr.io/veltara-works/vectis-orchestrator:{{ .Version }}
    container_name: vectis-orchestrator
    restart: unless-stopped
    # vectis-frontend gives the orchestrator outbound internet access —
    # required for release-channel discovery (fetches releases.json from
    # dl.vectismail.com via Plan). Without it, the orchestrator is trapped
    # on two `internal: true` networks and every release-channel fetch
    # fails DNS. Found during the 2026-04-23 rc25 §10 walkthrough.
    # Blast-radius note: orchestrator already holds the Docker socket, so
    # it's the most trusted container in the stack; incremental exposure
    # on vectis-frontend (shared with traefik/api) is minimal.
    networks:
      - vectis-frontend
      - vectis-orchestrator
      - vectis-data
    # P7-H1 capacity ceiling — see engine.go ResourceKnobs for the matrix.
    # Plan/Apply state machine is light; the in-flight diff + compose
    # template render are the heaviest steps and peak well under 100 MB.
    # Profile knob mainly matters for big-jump migrations computing large
    # config diffs on multi-domain installs.
    mem_limit: {{ .Resources.OrchestratorMemLimit }}
    # Bind to 127.0.0.1 only — exposes the orchestrator API to the host so
    # the `vectis update {plan,apply}` CLI can reach it at its default
    # http://localhost:8081 without an env-var workaround. Localhost-only
    # binding means the port is NOT reachable from outside the host; any
    # remote access still has to go through Traefik on a higher-level path.
    # Found during the 2026-05-08 sa1001 walkthrough — the CLI was
    # unusable on prod-shaped installs because orchestrator's port was
    # only reachable on its dynamic internal-network IP.
    ports:
      - "127.0.0.1:8081:8081"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      # /etc/vectis must be read-WRITE here so Phase 3.5 of Apply can rewrite
      # docker-compose.yml with the target image tags before Phase 4.3 pulls
      # and recreates containers. Pre-rc35 this was :ro — Phase 3.5 failed
      # silently with "read-only file system" trying to write its atomic
      # tmp-file-then-rename, and the follow-up rollback also failed for the
      # same reason. Caught during the 2026-04-24 sysadmin1001 walkthrough.
      # Blast-radius note: the orchestrator already has Docker socket access
      # (most trusted container in the stack), so incremental write access to
      # /etc/vectis is consistent with its existing privilege level. The api
      # service above keeps /etc/vectis mounted :ro — it only reads config.
      - /etc/vectis:/etc/vectis
      # /var/vectis/generated holds the per-service rendered configs
      # (postfix/dovecot/rspamd/...). Self-heal's RegenerateConfigs writes
      # here on cross-version startup; without this mount the orchestrator
      # silently fails to reconcile config drift on legacy installs.
      # See feedback_v0.1.5_selfheal_legacy_install_broken.md (v0.1.6).
      - /var/vectis/generated:/var/vectis/generated
      - snapshots:/var/vectis/snapshots
    depends_on:
      postgres:
        condition: service_healthy
      valkey:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null http://localhost:8081/internal/health"]
      interval: 5s
      timeout: 5s
      retries: 3
      start_period: 20s
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  postfix:
    image: ghcr.io/veltara-works/vectis-postfix:{{ .Version }}
    container_name: vectis-postfix
    restart: unless-stopped
    hostname: {{ .Hostname }}
    networks:
      - vectis-mail
      - vectis-data
    # P7-H1 capacity ceiling — see engine.go ResourceKnobs for the matrix.
    # smtpd/smtp/cleanup/qmgr processes are small. If you regularly burst
    # >100 concurrent SMTP sessions, raise to a larger profile and bump
    # smtpd_client_connection_count_limit in main.cf together so process
    # count and per-process RAM stay aligned.
    mem_limit: {{ .Resources.PostfixMemLimit }}
    ports:
      - "25:25"
      - "465:465"
      - "587:587"
    volumes:
      - /var/vectis/generated/postfix/main.cf:/etc/postfix/main.cf:ro
      - /var/vectis/generated/postfix/master.cf:/etc/postfix/master.cf:ro
      - /var/vectis/generated/postfix/pgsql_virtual_domains.cf:/etc/postfix/pgsql_virtual_domains.cf:ro
      - /var/vectis/generated/postfix/pgsql_virtual_mailboxes.cf:/etc/postfix/pgsql_virtual_mailboxes.cf:ro
      - /var/vectis/generated/postfix/pgsql_virtual_aliases.cf:/etc/postfix/pgsql_virtual_aliases.cf:ro
      - /var/vectis/generated/postfix/pgsql_virtual_catchall.cf:/etc/postfix/pgsql_virtual_catchall.cf:ro
      - /var/vectis/generated/postfix/pgsql_virtual_bcc.cf:/etc/postfix/pgsql_virtual_bcc.cf:ro
      - /var/vectis/generated/postfix/transport:/etc/postfix/transport:ro
      - /var/vectis/generated/postfix/inbound-notify.sh:/etc/postfix/inbound-notify.sh:ro
      - mail-data:/var/vectis/mail
      - mail-certs:/etc/ssl/mail:ro
      - postfix-logs:/var/log/postfix
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "postfix status || exit 1"]
      # interval shortened from 30s so the first probe fires inside the
      # apply window; with no start_period a 30s interval meant the first
      # check landed too late and the orchestrator's recreate race could
      # time out or read a transient boot failure as unhealthy.
      interval: 5s
      timeout: 10s
      retries: 3
      start_period: 30s
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  dovecot:
    image: ghcr.io/veltara-works/vectis-dovecot:{{ .Version }}
    container_name: vectis-dovecot
    restart: unless-stopped
    networks:
      - vectis-mail
      - vectis-data
    # P7-H1 capacity ceiling — see engine.go ResourceKnobs for the matrix.
    # imap/pop3/lmtp processes are per-connection; the `production` profile's
    # 1g comfortably handles ~200 concurrent IMAP clients. See P7-L1 for the
    # related dovecot.conf process_limit / client_limit tuning that should
    # land alongside this so cgroup + Dovecot's own caps agree.
    mem_limit: {{ .Resources.DovecotMemLimit }}
    ports:
      - "993:993"
      - "995:995"
      # ManageSieve protocol (RFC 5804) — clients use this to upload server-side
      # filter scripts. Dovecot listens on 4190 inside the container; the host
      # port mapping was missing pre-v0.1.6, so external sieve clients
      # (Roundcube, Thunderbird, etc.) could not reach it. Phase 2 E2E gap.
      - "4190:4190"
    volumes:
      - /var/vectis/generated/dovecot/dovecot.conf:/etc/dovecot/dovecot.conf:ro
      - /var/vectis/generated/dovecot/dovecot-sql.conf.ext:/etc/dovecot/dovecot-sql.conf.ext:ro
      # Global spam->Junk sieve (sieve_before). Always mounted (always rendered);
      # only referenced by dovecot.conf when rspamd.file_spam_to_junk is on.
      # Mounted :ro — Pigeonhole compiles the .svbin into the writable parent dir.
      - /var/vectis/generated/dovecot/spam-to-junk.sieve:/etc/dovecot/sieve/spam-to-junk.sieve:ro
      - mail-data:/var/vectis/mail
      - mail-certs:/etc/ssl/mail:ro
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "doveadm", "service", "status"]
      # Root cause of the v0.1.23 canary auto-rollback: with interval=30s
      # and no start_period, dovecot's first health probe fell outside the
      # apply recreate window, so the orchestrator timed out waiting and
      # rolled back even though dovecot 2.4 was fully functional (~1s ready,
      # doveconf -n clean). Verified fix: start_period=30s + interval=5s
      # makes the container report healthy at ~t+10s, well under the 60s
      # ServiceHealthTimeouts["dovecot"] window.
      interval: 5s
      timeout: 10s
      retries: 3
      start_period: 30s
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  rspamd:
    image: ghcr.io/veltara-works/vectis-rspamd:{{ .Version }}
    container_name: vectis-rspamd
    restart: unless-stopped
    networks:
      - vectis-mail
      - vectis-data
    # P7-H1 capacity ceiling — see engine.go ResourceKnobs for the matrix.
    # Lua plugins + Bayes statfiles + DNS resolver cache dominate. A runaway
    # Lua plugin (or expensive regex chain) will OOM-kill at this ceiling
    # rather than the host. See P7-L2 — rspamd worker count should be
    # cgroup-aware.
    mem_limit: {{ .Resources.RspamdMemLimit }}
    volumes:
      - /var/vectis/generated/rspamd/actions.conf:/etc/rspamd/local.d/actions.conf:ro
      - /var/vectis/generated/rspamd/classifier-bayes.conf:/etc/rspamd/local.d/classifier-bayes.conf:ro
      - /var/vectis/generated/rspamd/dkim_signing.conf:/etc/rspamd/local.d/dkim_signing.conf:ro
      - /var/vectis/generated/rspamd/milter_headers.conf:/etc/rspamd/local.d/milter_headers.conf:ro
      - /var/vectis/generated/rspamd/antivirus.conf:/etc/rspamd/local.d/antivirus.conf:ro
      - /var/vectis/generated/rspamd/worker-proxy.inc:/etc/rspamd/local.d/worker-proxy.inc:ro
      # Advanced Spam (Pro): per-domain settings overrides + Lua extension
      # that consults four allow/block map files keyed by recipient domain.
      # Files always exist (even on Free); empty files = no-op prefilter.
      - /var/vectis/generated/rspamd/settings.conf:/etc/rspamd/local.d/settings.conf:ro
      - /var/vectis/generated/rspamd/rspamd.local.lua:/etc/rspamd/rspamd.local.lua:ro
      - /var/vectis/generated/rspamd/maps:/etc/rspamd/local.d/maps:ro
      # DKIM keys bind-mount from the host (see api service note) so rspamd
      # signs with keys written by either the host CLI or the api.
      - /var/vectis/dkim:/var/vectis/dkim:ro
    depends_on:
      valkey:
        condition: service_healthy
    # Healthcheck hits the controller's /ping endpoint — auth-free, always
    # returns 200 once the controller worker is up. Earlier rcs used
    # `rspamadm control stat` which requires a controller password (we
    # don't set one) and returned 403 → container stuck "unhealthy" for
    # its entire lifetime even though rspamd was fully functional. Fixed
    # rc29 after the rc28 walkthrough proved rspamd was actually running
    # 4 workers + passing configtest; only the healthcheck was broken.
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:11334/ping"]
      interval: 5s
      timeout: 10s
      retries: 3
      # rspamd loads Lua plugins + Bayes statfiles before the controller
      # worker answers /ping; 30s grace covers a cold start.
      start_period: 30s
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"
{{ if .Webmail.Enabled }}
  # Vectis webmail — thin layer on roundcube/roundcubemail:1.7.1-apache
  # that bakes in the Vectis skin (extends elastic) and an entrypoint
  # task wiring config.docker.inc.php → config.vectis.inc.php.
  #
  # Pre-v0.1.8 this was the upstream fpm-alpine image fronted by a
  # separate vectis-webmail-nginx container; that split needed a
  # shared docroot volume between the two for static-asset serving,
  # which the template never set up — so /webmail/skins/elastic/styles.min.css
  # 404'd to /index.php and the login page rendered fully unstyled
  # since install. See docs/notes/deferred-items.md §13. The apache
  # image serves PHP + static files in one container, eliminating the chain.
  webmail:
    image: ghcr.io/veltara-works/vectis-webmail:{{ .Version }}
    container_name: vectis-webmail
    restart: unless-stopped
    networks:
      - vectis-frontend
      - vectis-mail
    # P7-H1 capacity ceiling — see engine.go ResourceKnobs for the matrix.
    # Apache + mod_php + roundcube. The `small` default (512m) covers a
    # modest pool of concurrent webmail sessions; bump profile (and tune
    # Apache MaxRequestWorkers) if you've enabled many roundcube plugins
    # or routinely send large attachments via the upload pipeline.
    mem_limit: {{ .Resources.WebmailMemLimit }}
    volumes:
      - webmail-data:/var/roundcube/db
      # Vectis-specific Roundcube config overrides. The baked-in
      # /entrypoint-tasks/post-setup/99_vectis_include.sh appends an
      # `include config.vectis.inc.php` line to the upstream-generated
      # config.docker.inc.php so this file's $config statements override
      # the env-var-driven defaults.
      #
      # Pre-v0.1.8: webmail-config was a named volume that nothing
      # ever populated — it carried install-time Roundcube auto-config,
      # and any engine-rendered roundcube.config.php update never
      # reached the running container.
      - /var/vectis/generated/webmail/roundcube.config.php:/var/www/html/config/config.vectis.inc.php:ro
    environment:
      ROUNDCUBEMAIL_DEFAULT_HOST: "ssl://vectis-dovecot"
      ROUNDCUBEMAIL_DEFAULT_PORT: "993"
      ROUNDCUBEMAIL_SMTP_SERVER: "tls://vectis-postfix"
      ROUNDCUBEMAIL_SMTP_PORT: "587"
      ROUNDCUBEMAIL_DB_TYPE: "sqlite"
      ROUNDCUBEMAIL_UPLOAD_MAX_FILESIZE: "{{ if .Webmail.UploadMaxMB }}{{ .Webmail.UploadMaxMB }}{{ else }}25{{ end }}M"
      ROUNDCUBEMAIL_SKIN: "vectis"
      ROUNDCUBEMAIL_PLUGINS: "archive,managesieve,zipdownload"
    depends_on:
      dovecot:
        condition: service_healthy
      postfix:
        condition: service_healthy
    # roundcubemail:apache (debian base) ships curl but NOT wget — caught
    # on prod 2026-05-04 rc5 walkthrough: wget healthcheck fired 9 times
    # in a row "wget: not found" and marked the container unhealthy.
    healthcheck:
      test: ["CMD-SHELL", "curl -sfo /dev/null http://localhost/ || exit 1"]
      interval: 5s
      timeout: 10s
      retries: 3
      # Apache + mod_php cold start; grace before the orchestrator's
      # default WaitHealthy window would count early misses as failures.
      start_period: 30s
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"
{{ end }}
{{ if .Observability.LokiEnabled }}
  loki:
    image: grafana/loki:3.4
    container_name: vectis-loki
    restart: unless-stopped
    networks:
      - vectis-data
    # P7-H1 capacity ceiling — see engine.go ResourceKnobs for the matrix.
    # Single-binary Loki + filesystem chunks. Index RAM scales with stream
    # count — P7-H3 (drop the user label) and P7-M5 (cardinality caps) both
    # keep this bound from creeping up as mailbox count grows.
    mem_limit: {{ .Resources.LokiMemLimit }}
    command: -config.file=/etc/loki/loki.yml
    volumes:
      - loki-config:/etc/loki:ro
      - loki-data:/loki
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null http://localhost:3100/ready"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 20s
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

  promtail:
    image: grafana/promtail:3.4
    container_name: vectis-promtail
    restart: unless-stopped
    networks:
      - vectis-data
    # P7-H1 capacity ceiling — see engine.go ResourceKnobs for the matrix.
    # Log scraper; per-pipeline JSON/regex parsing on the small handful of
    # Vectis containers. Even the `dev` profile (64m) is plenty.
    mem_limit: {{ .Resources.PromtailMemLimit }}
    command: -config.file=/etc/promtail/promtail.yml
    volumes:
      - promtail-config:/etc/promtail:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
    depends_on:
      loki:
        condition: service_healthy
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"
{{ end }}
{{ if .Observability.GrafanaEnabled }}
  grafana:
    image: grafana/grafana:11.5
    container_name: vectis-grafana
    restart: unless-stopped
    networks:
      - vectis-frontend
      - vectis-data
    # P7-H1 capacity ceiling — see engine.go ResourceKnobs for the matrix.
    # UI + query layer over Loki. Built-in dashboards fit comfortably even
    # at `small`; bump profile if you've added heavy data sources or have
    # many concurrent dashboard viewers.
    mem_limit: {{ .Resources.GrafanaMemLimit }}
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD__FILE: /run/secrets/grafana_admin_password
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_SERVER_ROOT_URL: "https://{{ .Hostname }}/grafana/"
      GF_SERVER_SERVE_FROM_SUB_PATH: "true"
    secrets:
      - grafana_admin_password
    volumes:
      - grafana-data:/var/lib/grafana
    depends_on:
      api:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null http://localhost:3000/api/health"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"
{{ end }}
{{ if ne .ClamAV.Profile "none" }}
  clamav:
    image: ghcr.io/veltara-works/vectis-clamav:{{ .Version }}
    container_name: vectis-clamav
    restart: unless-stopped
    networks:
      - vectis-mail
    # Per-profile RAM ceiling (ADR-007). Compose `mem_limit` translates to
    # the container's memory cgroup; clamd's MaxThreads in clamd.conf is
    # tuned to fit inside this. A profile bump rewrites both numbers
    # together so they don't drift.
    mem_limit: {{ .ClamAV.MemLimit }}
    volumes:
      - /var/vectis/generated/clamav/clamd.conf:/etc/clamav/clamd.conf:ro
      # Signature database persistence — without this, every `docker
      # restart` triggers a ~1.5 GB freshclam re-download and the
      # container is unusable for ~5 minutes after each cycle. The named
      # volume is seeded from the image's pre-baked DB on first create
      # (see docker/clamav/Dockerfile) and refreshed in-place by the
      # entrypoint's freshclam --daemon.
      - clamav-data:/var/lib/clamav
    healthcheck:
      # `clamdscan --ping=N` exits 0 when clamd PONGs within N seconds.
      # Real binary; replaces the rc60-and-earlier `clamdcheck` which
      # never existed in any clamav package and silently kept the
      # container "starting" forever.
      test: ["CMD-SHELL", "clamdscan --ping=1 || exit 1"]
      interval: 60s
      timeout: 15s
      retries: 3
      # Generous start_period: a fresh clamav-data volume must complete
      # an initial freshclam (~1.5 GB) before clamd can answer. Once
      # warm, subsequent restarts pong in <1s.
      start_period: 300s
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"
{{ end }}
{{ if eq .TLS.Provider "letsencrypt" }}
  # Mail-cert extractor: mirrors the Let's Encrypt cert Traefik already
  # holds for {{ .Hostname }} from traefik-acme/acme.json into the
  # mail-certs volume, then SIGHUPs postfix + dovecot so they reload.
  #
  # Replaces the old acme.sh sidecar (broken on non-Cloudflare installs
  # since it landed — see deferred-items.md §10 GA Blocker #6). Traefik
  # already issues + renews the cert as a side-effect of serving the
  # admin UI over HTTPS, so running a second ACME client was duplicative
  # and created four distinct failure modes (no account email default,
  # ZeroSSL-default CA, no /acme.sh home bootstrap, port-80 contention).
  cert-extractor:
    image: ghcr.io/veltara-works/vectis-cert-extractor:{{ .Version }}
    container_name: vectis-cert-extractor
    restart: unless-stopped
    networks:
      - vectis-mail
    # P7-H1 capacity ceiling — see engine.go ResourceKnobs for the matrix.
    # Tiny Go binary; idles below 20 MB and only wakes on acme.json mtime
    # change. Even the `dev` profile (32m) is generous headroom.
    mem_limit: {{ .Resources.CertExtractorMemLimit }}
    volumes:
      - traefik-acme:/var/traefik/acme:ro
      - mail-certs:/etc/ssl/mail
      # Docker socket gives the extractor the ability to `docker kill
      # --signal=HUP` postfix/dovecot when the cert rotates. Scope is
      # intentionally read-write (socket mounts don't honour :ro for
      # write operations) — blast radius comparable to the old acme.sh
      # sidecar which also had the socket for its deploy hook.
      - /var/run/docker.sock:/var/run/docker.sock
    command:
      - --acme-json=/var/traefik/acme/acme.json
      - --hostname={{ .Hostname }}
      - --out-dir=/etc/ssl/mail
      - --reload-postfix=vectis-postfix
      - --reload-dovecot=vectis-dovecot
      - --watch
    depends_on:
      traefik:
        condition: service_healthy
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"
{{ end }}

  postgres:
    image: postgres:17-alpine
    container_name: vectis-postgres
    restart: unless-stopped
    networks:
      - vectis-data
    # P7-H1 capacity ceiling — see engine.go ResourceKnobs for the matrix.
    # shared_buffers + work_mem + the per-backend process pool. The
    # `production` profile's 2g is sized against the default postgres pool
    # (P7-M1: 20 conns) on a small-to-medium install. If you've raised pool
    # size or shared_buffers (P7-M2 follow-up), bump profile together.
    mem_limit: {{ .Resources.PostgresMemLimit }}
    # No host port publishing: `vectis-data` is `internal: true`, which
    # makes Docker silently drop any `ports:` directive. Host-side tooling
    # (migrations, admin seeding) therefore runs in a one-shot container
    # attached to this network — see install_cmd.go and vectis admin init.
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: "{{ .Database.SuperuserPassword }}"
      POSTGRES_DB: "{{ .Database.Name }}"
      VECTIS_API_PASSWORD: "{{ .Database.APIPassword }}"
      VECTIS_POSTFIX_PASSWORD: "{{ .Database.PostfixPassword }}"
      VECTIS_DOVECOT_PASSWORD: "{{ .Database.DovecotPassword }}"
    volumes:
      - pgdata:/var/lib/postgresql/data
      - /var/vectis/generated/postgres/init-users.sh:/docker-entrypoint-initdb.d/01-init-users.sh:ro
    # Healthcheck must hit TCP, not the unix socket: during first-start
    # postgres runs init scripts against a temp server bound only to the
    # socket, so a socket-only `pg_isready` reports healthy before the
    # 5432 listener is up. Forcing -h 127.0.0.1 guarantees that downstream
    # containers waiting on `condition: service_healthy` only unblock once
    # the real TCP listener is accepting connections.
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -p 5432 -U postgres -d {{ .Database.Name }}"]
      interval: 5s
      timeout: 5s
      retries: 20
      # First-boot init (createdb + init-users.sh) runs against a
      # socket-only temp server before the TCP listener is up; the grace
      # keeps those expected early misses out of the failure count, and
      # retries=20 carries the rest. Kept under the 30s per-service
      # ServiceHealthTimeouts["postgres"] window. On upgrades the data dir
      # already exists, so postgres is healthy in a few seconds.
      start_period: 20s
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"
{{ if .Cluster.PgBouncer.Enabled }}
  pgbouncer:
    image: edoburu/pgbouncer:1.23.1-p2
    container_name: vectis-pgbouncer
    restart: unless-stopped
    networks:
      - vectis-data
    # P7-H1 capacity ceiling — see engine.go ResourceKnobs for the matrix.
    # Single-process connection pooler; very small footprint regardless of
    # pool size. Even the `dev` profile (64m) is plenty.
    mem_limit: {{ .Resources.PgBouncerMemLimit }}
    volumes:
      - pgbouncer-config:/etc/pgbouncer:ro
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h localhost -p {{ if .Cluster.PgBouncer.ListenPort }}{{ .Cluster.PgBouncer.ListenPort }}{{ else }}6432{{ end }}"]
      interval: 5s
      timeout: 5s
      retries: 3
      start_period: 15s
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"
{{ end }}
  valkey:
    image: valkey/valkey:8-alpine
    container_name: vectis-valkey
    restart: unless-stopped
    networks:
      - vectis-data
    # P7-H1 capacity ceiling — see engine.go ResourceKnobs for the matrix.
    # Cgroup ceiling sits above the in-server --maxmemory below so valkey
    # hits its own LRU eviction (graceful) before the kernel OOM-killer
    # (hard reset). Both numbers move together when profile changes.
    mem_limit: {{ .Resources.ValkeyMemLimit }}
    entrypoint: ["sh", "-c"]
    # P7-H2: --maxmemory + allkeys-lru protect against credential-stuffing
    # session-key floods and any other unbounded-write bug. All Vectis
    # keys carry TTLs and tolerate LRU eviction. ValkeyMaxMemory sits at
    # ~50% of ValkeyMemLimit so valkey starts evicting before the cgroup
    # OOM-kills the process.
    command:
      - |
        exec valkey-server \
          --requirepass "$$(cat /run/secrets/valkey_password)" \
          --maxmemory {{ .Resources.ValkeyMaxMemory }} \
          --maxmemory-policy allkeys-lru \
          --save 60 1000 \
          --save 300 100{{ if .Cluster.Enabled }} \
          --min-replicas-to-write 0 \
          --min-replicas-max-lag 10{{ end }}
    secrets:
      - valkey_password
    volumes:
      - valkeydata:/data
    healthcheck:
      test: ["CMD-SHELL", "valkey-cli -a \"$$(cat /run/secrets/valkey_password)\" ping"]
      interval: 5s
      timeout: 5s
      retries: 5
      # Under the 15s ServiceHealthTimeouts["valkey"] window so a failed
      # start can still surface as unhealthy rather than only timing out.
      start_period: 10s
    logging:
      driver: {{ .Logging.Driver }}
      options:
        max-size: "{{ .Logging.MaxSizeMB }}m"
        max-file: "{{ .Logging.MaxFiles }}"

networks:
  vectis-frontend:
    driver: {{ if .Cluster.Enabled }}overlay{{ else }}bridge{{ end }}
    internal: false
  vectis-mail:
    driver: {{ if .Cluster.Enabled }}overlay{{ else }}bridge{{ end }}
    # MUST be external: mail by definition flows in/out of the public
    # internet (inbound port 25, outbound delivery to other MTAs, IMAPS
    # connections from end-user clients). Docker silently drops `ports:`
    # directives on containers whose networks are ALL `internal: true`,
    # so setting this to `true` on vectis-mail meant postfix/dovecot's
    # host port publishing was never honoured — postfix status +
    # doveadm service status still reported healthy (their healthchecks
    # are process-local), but 25/465/587/993/995 weren't bound on the
    # host. Surfaced rc27 walkthrough on sysadmin1001 — first install
    # where dovecot actually stayed up long enough for the missing port
    # bindings to be observable. Do NOT revert to `true` even if it
    # feels cleaner.
    internal: false
  vectis-data:
    driver: {{ if .Cluster.Enabled }}overlay{{ else }}bridge{{ end }}
    internal: true
  vectis-orchestrator:
    driver: {{ if .Cluster.Enabled }}overlay{{ else }}bridge{{ end }}
    internal: true

volumes:
  pgdata:
  valkeydata:
  mail-data:
  mail-certs:
  postfix-logs:
  traefik-acme:
  snapshots:
{{ if ne .ClamAV.Profile "none" }}
  clamav-data:
{{ end }}
{{ if .Cluster.PgBouncer.Enabled }}
  pgbouncer-config:
{{ end }}
{{ if .Observability.GrafanaEnabled }}
  grafana-data:
{{ end }}
{{ if .Webmail.Enabled }}
  webmail-data:
{{ end }}
{{ if .Observability.LokiEnabled }}
  loki-config:
  loki-data:
  promtail-config:
{{ end }}

secrets:
  valkey_password:
    file: /var/vectis/generated/secrets/valkey_password
{{ if .Observability.GrafanaEnabled }}
  grafana_admin_password:
    file: /var/vectis/generated/secrets/grafana_admin_password
{{ end }}
