#!/bin/sh
# Vectis Mail Server — Postfix inbound notification pipe
# Generated by config engine — do not edit manually
#
# Invoked by the `vectis_notify` pipe service in master.cf for every BCC copy
# of an inbound message. Reads the raw RFC 5322 message from stdin and POSTs
# it to the Vectis API, which parses MIME parts and fires webhooks.
#
# Argv:
#   $1 = ${user}    — encoded original recipient local-part (see pgsql_virtual_bcc.cf)
#   $2 = ${sender}  — envelope sender
#   $3 = ${queue_id}
#
# The original recipient is encoded as `local=domain` in the BCC's local part
# (pgsql REPLACE('@','=')) so the pipe doesn't lose it. We decode back to
# `local@domain` here and send that as the real envelope recipient to the API.
#
# Exits 0 unconditionally — never block mail delivery because of webhook issues.

API_URL="http://vectis-api:8080/api/v1/internal/inbound"
# Scoped token derived from the API secret (HMAC), NOT the master secret itself:
# this script is world-readable in the container (Postfix runs it as nobody), so
# it must never carry the key that also protects sessions/TOTP/webhooks/imports.
INTERNAL_TOKEN="{{ .InboundNotifyToken }}"

ENCODED_USER="${1:-}"
ENV_SENDER="${2:-}"
Q_ID="${3:-}"

# Decode `=` → `@` to recover the original envelope recipient. If the encoded
# user has no `=`, we fall back to the raw value (defensive — shouldn't happen).
REAL_RECIPIENT=$(printf '%s' "$ENCODED_USER" | tr '=' '@')
case "$REAL_RECIPIENT" in
    *@*) ;;
    *) exit 0 ;;
esac
REAL_DOMAIN="${REAL_RECIPIENT#*@}"

# Capture full raw message to a temp file — we need it both for header
# extraction and for the base64-encoded body in the payload, and piping
# the whole thing through command-line args would blow ARG_MAX on large
# attachments.
RAW_FILE=$(mktemp /tmp/vectis-inbound.XXXXXX) || exit 0
PAYLOAD_FILE=$(mktemp /tmp/vectis-payload.XXXXXX) || { rm -f "$RAW_FILE"; exit 0; }
trap 'rm -f "$RAW_FILE" "$PAYLOAD_FILE"' EXIT
cat > "$RAW_FILE"

# Extract headers from the top of the message (stop at first blank line so we
# don't scan MIME parts in the body).
HEADERS=$(awk 'BEGIN{RS=""} NR==1{print; exit}' "$RAW_FILE")
MESSAGE_ID=$(printf '%s\n' "$HEADERS" | sed -n 's/^[Mm]essage-[Ii][Dd]:[[:space:]]*<\{0,1\}\([^>[:space:]]*\)>\{0,1\}.*$/\1/p' | head -1)
FROM=$(printf '%s\n' "$HEADERS"       | sed -n 's/^[Ff]rom:[[:space:]]*//p' | head -1)
SUBJECT=$(printf '%s\n' "$HEADERS"    | sed -n 's/^[Ss]ubject:[[:space:]]*//p' | head -1)
SPAM_SCORE=$(printf '%s\n' "$HEADERS" | sed -n 's/^[Xx]-[Ss]pam-[Ss]core:[[:space:]]*\([-0-9.]*\).*/\1/p' | head -1)
SPAM_ACTION=$(printf '%s\n' "$HEADERS" | sed -n 's/^[Xx]-[Ss]pam-[Aa]ction:[[:space:]]*//p' | head -1)

SIZE=$(wc -c < "$RAW_FILE" | tr -d ' ')
# BusyBox base64 wraps at 76 chars; strip newlines for single-line JSON embedding.
RAW_B64=$(base64 < "$RAW_FILE" | tr -d '\n')

# Minimal JSON string escaper: backslash, double-quote, then strip CR/LF.
esc() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\r\n'
}

cat > "$PAYLOAD_FILE" <<JSON
{"message_id":"$(esc "$MESSAGE_ID")","from":"$(esc "$FROM")","to":"$(esc "$REAL_RECIPIENT")","domain":"$(esc "$REAL_DOMAIN")","subject":"$(esc "$SUBJECT")","size":${SIZE:-0},"spam_score":${SPAM_SCORE:-0},"spam_action":"$(esc "${SPAM_ACTION:-no action}")","queue_id":"$(esc "$Q_ID")","envelope_from":"$(esc "$ENV_SENDER")","envelope_to":"$(esc "$REAL_RECIPIENT")","raw_message_b64":"$RAW_B64"}
JSON

# Fire-and-forget: cap total time at 10s, never fail delivery (always exit 0).
# But do NOT swallow the outcome silently (CR119-3): capture the HTTP status and
# log a one-line failure to stderr, which Postfix routes to maillog. A silent
# `|| true` hid whole classes of breakage — e.g. every /internal/inbound POST
# returning 401 after an api.secret rotation (stale INTERNAL_TOKEN) — with zero
# operator signal. We drop -f so a 4xx/5xx still yields the real status code
# rather than curl exit 22 with no body.
HTTP_CODE=$(curl -s -o /dev/null -w '%{http_code}' -X POST "$API_URL" \
    -H "Content-Type: application/json" \
    -H "X-Internal-Token: $INTERNAL_TOKEN" \
    --max-time 10 \
    --data-binary @"$PAYLOAD_FILE" 2>/dev/null)
CURL_RC=$?
HTTP_CODE=${HTTP_CODE:-000}
if [ "$CURL_RC" -ne 0 ] || [ "$HTTP_CODE" -lt 200 ] || [ "$HTTP_CODE" -ge 300 ]; then
    echo "vectis_notify: inbound POST failed (curl_rc=${CURL_RC} http=${HTTP_CODE} recipient=${REAL_RECIPIENT} queue=${Q_ID})" >&2
fi

exit 0
