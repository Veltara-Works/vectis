#!/bin/sh
# Vectis Mail Server — Postfix inbound notification script
# Generated by config engine — do not edit manually
#
# Called by Postfix via pipe transport after Rspamd filtering.
# Reads the full RFC 5322 message from stdin and posts it to the
# Vectis API, which parses MIME parts and fires webhooks.
#
# Envelope data comes from Postfix pipe transport variables:
#   $SENDER   — SMTP envelope MAIL FROM
#   $RECIPIENT — SMTP envelope RCPT TO

API_URL="http://vectis-api:8080/api/v1/internal/inbound"
INTERNAL_TOKEN="{{ .API.Secret }}"

# Capture the full raw message from stdin.
RAW_MESSAGE=$(cat)

# Extract key headers for the metadata-only notification (fast path).
MESSAGE_ID=$(echo "$RAW_MESSAGE" | sed -n 's/^[Mm]essage-[Ii][Dd]: *<\?\([^>]*\)>\?$/\1/p' | head -1)
FROM=$(echo "$RAW_MESSAGE" | sed -n 's/^[Ff]rom: *//p' | head -1)
SUBJECT=$(echo "$RAW_MESSAGE" | sed -n 's/^[Ss]ubject: *//p' | head -1)
SPAM_SCORE=$(echo "$RAW_MESSAGE" | sed -n 's/^[Xx]-[Ss]pam-[Ss]core: *\([^ ]*\).*/\1/p' | head -1)
SPAM_ACTION=$(echo "$RAW_MESSAGE" | sed -n 's/^[Xx]-[Ss]pam-[Aa]ction: *//p' | head -1)

# Envelope data from Postfix pipe transport.
ENVELOPE_FROM="${SENDER:-$FROM}"
ENVELOPE_TO="${RECIPIENT:-}"

# Extract domain from envelope recipient.
DOMAIN=$(echo "$ENVELOPE_TO" | sed 's/.*@//')

# Base64-encode the full raw message for the API.
RAW_B64=$(echo "$RAW_MESSAGE" | base64 -w 0 2>/dev/null || echo "$RAW_MESSAGE" | base64 2>/dev/null)

# Post full message to API (fire-and-forget; don't block delivery on API failure).
curl -sf -X POST "$API_URL" \
    -H "Content-Type: application/json" \
    -H "X-Internal-Token: $INTERNAL_TOKEN" \
    --max-time 10 \
    -d "{
        \"message_id\": \"$MESSAGE_ID\",
        \"from\": \"$FROM\",
        \"to\": \"$ENVELOPE_TO\",
        \"domain\": \"$DOMAIN\",
        \"subject\": \"$SUBJECT\",
        \"spam_score\": ${SPAM_SCORE:-0},
        \"spam_action\": \"${SPAM_ACTION:-no action}\",
        \"queue_id\": \"$QUEUE_ID\",
        \"envelope_from\": \"$ENVELOPE_FROM\",
        \"envelope_to\": \"$ENVELOPE_TO\",
        \"raw_message_b64\": \"$RAW_B64\"
    }" >/dev/null 2>&1 &

# Always exit 0 — never block mail delivery.
exit 0
