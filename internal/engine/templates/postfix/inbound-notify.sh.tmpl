#!/bin/sh
# Vectis Mail Server — Postfix inbound notification script
# Generated by config engine — do not edit manually
#
# Called by Postfix via header_checks FILTER pipe transport after delivery.
# Posts message metadata to the Vectis API for webhook dispatch.
# Reads the message from stdin, extracts headers, and notifies the API.

API_URL="http://vectis-api:8080/api/v1/internal/inbound"
INTERNAL_TOKEN="{{ .API.Secret }}"

# Read headers from stdin (up to empty line).
MESSAGE_ID=""
FROM=""
TO="$RECIPIENT"
SUBJECT=""
SPAM_SCORE=""
SPAM_ACTION=""

while IFS= read -r line; do
    case "$line" in
        "") break ;;
        Message-ID:*|Message-Id:*) MESSAGE_ID=$(echo "$line" | sed 's/^[^:]*: *//;s/[<>]//g') ;;
        From:*) FROM=$(echo "$line" | sed 's/^[^:]*: *//') ;;
        Subject:*) SUBJECT=$(echo "$line" | sed 's/^[^:]*: *//') ;;
        X-Spam-Score:*|X-Spamd-Result:*) SPAM_SCORE=$(echo "$line" | sed 's/^[^:]*: *//;s/ .*//' ) ;;
        X-Spam-Action:*) SPAM_ACTION=$(echo "$line" | sed 's/^[^:]*: *//') ;;
    esac
done

# Extract domain from recipient.
DOMAIN=$(echo "$TO" | sed 's/.*@//')

# Post to API (fire-and-forget; don't block delivery on API failure).
curl -sf -X POST "$API_URL" \
    -H "Content-Type: application/json" \
    -H "X-Internal-Token: $INTERNAL_TOKEN" \
    -d "{
        \"message_id\": \"$MESSAGE_ID\",
        \"from\": \"$FROM\",
        \"to\": \"$TO\",
        \"domain\": \"$DOMAIN\",
        \"subject\": \"$SUBJECT\",
        \"spam_score\": ${SPAM_SCORE:-0},
        \"spam_action\": \"${SPAM_ACTION:-no action}\",
        \"queue_id\": \"$QUEUE_ID\"
    }" >/dev/null 2>&1 &

# Always exit 0 — never block mail delivery.
exit 0
