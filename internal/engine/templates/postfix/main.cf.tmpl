# Vectis Mail Server — Postfix main.cf
# Generated by config engine — do not edit manually

# Identity
smtpd_banner = {{ .Postfix.SmtpBanner }}
myhostname = {{ .Hostname }}
mydomain = {{ .Hostname }}
myorigin = $mydomain
mydestination =
mynetworks = 127.0.0.0/8 [::1]/128 172.16.0.0/12

# Virtual domain hosting (SQL-driven per ADR-010)
virtual_mailbox_domains = pgsql:/etc/postfix/pgsql_virtual_domains.cf
virtual_mailbox_maps = pgsql:/etc/postfix/pgsql_virtual_mailboxes.cf
virtual_alias_maps = pgsql:/etc/postfix/pgsql_virtual_aliases.cf,
                     pgsql:/etc/postfix/pgsql_virtual_catchall.cf
virtual_mailbox_base = /var/vectis/mail
virtual_uid_maps = static:5000
virtual_gid_maps = static:5000
virtual_minimum_uid = 5000

# Delivery via LMTP to Dovecot (ADR-008: TCP port 24)
virtual_transport = lmtp:inet:dovecot:24

# Disable SMTPUTF8 negotiation on the LMTP transport. Dovecot 2.3.x's LMTP
# listener does not advertise SMTPUTF8 in EHLO, so when an inbound message
# carries 8-bit UTF-8 in headers (a real-world Subject like "Café") postfix
# bounces local delivery with `SMTPUTF8 is required, but was not offered by
# host dovecot`. With this off, postfix downgrades 8-bit headers to MIME
# encoded-word form before LMTP and delivery succeeds. SMTPUTF8 stays
# enabled for the egress smtp() transport so external hops keep using it
# when supported. (Found by 2026-05-10 fresh-VPS §10 walkthrough — see
# docs/notes/2026-05-10-fresh-vps-walkthrough-v0.1.10.md FINDING #2.)
lmtp_smtputf8_enable = no

# Inbound notification — BCC a copy of every inbound message to a synthetic
# address under the reserved vectis.notify zone, which transport_maps routes
# to the vectis_notify pipe service (master.cf). The pipe script POSTs the
# raw message to /api/v1/internal/inbound, which fires mail.received /
# mail.received.full / mail.spam / mail.complained webhooks.
#
# The pgsql lookup only returns a BCC address for recipients whose domain
# is in the local `domains` table, so outbound mail from submission/smtps
# (recipient domain external) never triggers it. The BCC address encodes
# the original recipient in the local part (@ → =) so the pipe script can
# recover it; the BCC leg doesn't re-enter cleanup, so no loop.
recipient_bcc_maps = pgsql:/etc/postfix/pgsql_virtual_bcc.cf
transport_maps = texthash:/etc/postfix/transport

# TLS — inbound (port 25 stays opportunistic per RFC 3207; 587/465 enforce in master.cf)
smtpd_tls_cert_file = /etc/ssl/mail/fullchain.pem
smtpd_tls_key_file = /etc/ssl/mail/privkey.pem
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_mandatory_ciphers = high
smtpd_tls_mandatory_exclude_ciphers = aNULL, MD5, DES, 3DES, RC4, EXPORT, LOW, SEED, IDEA
smtpd_tls_exclude_ciphers = aNULL, MD5, DES, 3DES, RC4, EXPORT, LOW
tls_preempt_cipherlist = yes
smtpd_tls_loglevel = 1
smtpd_tls_received_header = yes
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache

# TLS — outbound (opportunistic; upgrade to dane when unbound sidecar is added)
smtp_tls_security_level = may
smtp_tls_protocols = >=TLSv1.2
smtp_tls_mandatory_protocols = >=TLSv1.2
smtp_tls_mandatory_ciphers = high
smtp_tls_mandatory_exclude_ciphers = aNULL, MD5, DES, 3DES, RC4, EXPORT, LOW, SEED, IDEA
smtp_tls_exclude_ciphers = aNULL, MD5, DES, 3DES, RC4, EXPORT, LOW
smtp_tls_loglevel = 1
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache

# Message limits
message_size_limit = {{ .Postfix.MessageSizeLimit }}

# SASL authentication (Dovecot handles auth)
smtpd_sasl_type = dovecot
smtpd_sasl_path = inet:dovecot:12345
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous
smtpd_sasl_local_domain = $myhostname

# Restrictions
smtpd_relay_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination

smtpd_recipient_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination,
    reject_unknown_recipient_domain

# Milter (Rspamd)
smtpd_milters = inet:rspamd:11332
non_smtpd_milters = $smtpd_milters
milter_protocol = 6
milter_default_action = accept
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}

# Network protocols — support both IPv4 and IPv6 (Phase 0.5 scope)
inet_protocols = all

# Misc
# Log to a file on the shared postfix-logs volume so the API container can
# tail delivery status events (mail.delivered / mail.bounced webhooks).
# The entrypoint also tails this file to stdout to preserve `docker logs` output.
maillog_file = /var/log/postfix/mail.log
compatibility_level = 3.6
