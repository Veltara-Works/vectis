# Vectis Mail Server — Postfix main.cf
# Generated by config engine — do not edit manually

# Identity
smtpd_banner = {{ .Postfix.SmtpBanner }}
myhostname = {{ .Hostname }}
mydomain = {{ .Hostname }}
myorigin = $mydomain
mydestination =
mynetworks = 127.0.0.0/8 [::1]/128

# Virtual domain hosting (SQL-driven per ADR-010)
virtual_mailbox_domains = pgsql:/etc/postfix/pgsql_virtual_domains.cf
virtual_mailbox_maps = pgsql:/etc/postfix/pgsql_virtual_mailboxes.cf
virtual_alias_maps = pgsql:/etc/postfix/pgsql_virtual_aliases.cf,
                     pgsql:/etc/postfix/pgsql_virtual_catchall.cf
virtual_mailbox_base = /var/vectis/mail
virtual_uid_maps = static:5000
virtual_gid_maps = static:5000
virtual_minimum_uid = 5000

# Delivery via LMTP to Dovecot (ADR-008: TCP port 24)
virtual_transport = lmtp:inet:dovecot:24

# TLS — inbound
smtpd_tls_cert_file = /etc/ssl/mail/fullchain.pem
smtpd_tls_key_file = /etc/ssl/mail/privkey.pem
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2

# TLS — outbound
smtp_tls_security_level = may
smtp_tls_protocols = >=TLSv1.2

# Message limits
message_size_limit = {{ .Postfix.MessageSizeLimit }}

# SASL authentication (Dovecot handles auth)
smtpd_sasl_type = dovecot
smtpd_sasl_path = inet:dovecot:12345
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous
smtpd_sasl_local_domain = $myhostname

# Restrictions
smtpd_relay_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination

smtpd_recipient_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination,
    reject_unknown_recipient_domain

# Milter (Rspamd)
smtpd_milters = inet:rspamd:11332
non_smtpd_milters = $smtpd_milters
milter_protocol = 6
milter_default_action = accept
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}

# Misc
maillog_file = /dev/stdout
compatibility_level = 3.6
