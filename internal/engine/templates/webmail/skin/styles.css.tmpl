/* Vectis Webmail — Elastic skin customization
 * Generated by config engine — do not edit manually.
 *
 * Loaded after elastic's styles via meta.json `extends: elastic`,
 * so these CSS-variable overrides win without re-compiling LESS.
 */

:root {
  /* Vectis brand palette — slate-blue primary, clean dark sidebar */
  --color-main:              #3b82f6;
  --color-main-dark:         #2563eb;
  --main-color:              #3b82f6;
  --color-link:              #3b82f6;

  --layout-header-background: #0f172a;
  --color-toolbar-button:     #94a3b8;

  --color-list-selected:      #dbeafe;
  --color-list-selected-background: #dbeafe;

  --btn-primary-color:         #fff;
  --btn-primary-background:    #3b82f6;
}

#login-form h1,
.login-title {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  letter-spacing: 0.025em;
}

#layout-sidebar .footer a[href*="roundcube.net"] {
  display: none;
}

#layout-sidebar .footer::after {
  content: "Powered by Vectis Mail";
  display: block;
  font-size: 0.75rem;
  color: #64748b;
  text-align: center;
  padding: 0.5rem 0;
}
