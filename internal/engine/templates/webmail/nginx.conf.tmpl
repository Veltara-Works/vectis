server {
    listen 8080;
    server_name _;

    root /var/www/html;
    index index.php;

    client_max_body_size {{ if .Webmail.UploadMaxMB }}{{ .Webmail.UploadMaxMB }}{{ else }}25{{ end }}m;

    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    location ~ \.php$ {
        fastcgi_pass vectis-webmail:9000;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 60s;
    }

    location ~ /\. {
        deny all;
    }
}
