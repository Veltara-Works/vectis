<?php
// Vectis Mail — Roundcube config overrides.
// Generated by config engine — bind-mounted into the webmail container at
// /var/www/html/config/config.vectis.inc.php and included by config.docker.inc.php
// (the upstream image's docker-config) via /entrypoint-tasks/post-setup/99_vectis_include.sh.
//
// This file is loaded AFTER config.inc.php and config.docker.inc.php, so
// $config statements here override anything set earlier — including the
// env-var-driven ROUNDCUBEMAIL_* defaults baked by the upstream entrypoint.

// IMAP — connect to Dovecot via SSL on the mail network.
$config['imap_host'] = 'ssl://vectis-dovecot:993';
$config['imap_conn_options'] = [
    'ssl' => ['verify_peer' => false, 'verify_peer_name' => false],
];

// SMTP — connect to Postfix via STARTTLS on the mail network.
$config['smtp_host'] = 'tls://vectis-postfix:587';
$config['smtp_conn_options'] = [
    'ssl' => ['verify_peer' => false, 'verify_peer_name' => false],
];
$config['smtp_user'] = '%u';
$config['smtp_pass'] = '%p';

// Session & security.
$config['des_key']          = '{{ .RoundcubeDESKey }}';
$config['product_name']     = 'Vectis Webmail';
$config['support_url']      = '';
$config['session_lifetime'] = 30;
$config['ip_check']         = true;
$config['useragent']        = 'Vectis Webmail';
$config['x_frame_options']  = 'sameorigin';

// Reverse-proxy path prefix — Traefik routes /webmail/* to this container
// and strips /webmail before forwarding. Without this, Roundcube generates
// URLs with no /webmail/ prefix and the login form POSTs land on the bare
// host (which routes to the Admin UI). Setting request_path makes Roundcube
// add the prefix back when emitting URLs.
$config['request_path'] = '/webmail/';

// SQLite session DB lives in the webmail-data named volume.
$config['db_dsnw'] = 'sqlite:////var/roundcube/db/roundcube.db?mode=0640';

// Active skin — Vectis (extends Elastic via skins/vectis/meta.json,
// baked into the vectis-webmail image at build time).
$config['skin'] = 'vectis';

// Plugins (env var doesn't enable identity_select).
$config['plugins'] = [
    'archive',
    'managesieve',
    'zipdownload',
    'identity_select',
];

// ManageSieve — connect to Dovecot's Sieve service.
$config['managesieve_host']         = 'vectis-dovecot';
$config['managesieve_port']         = 4190;
$config['managesieve_usetls']       = false;
$config['managesieve_conn_options'] = null;

// Upload limits.
$config['upload_max_filesize'] = '{{ if .Webmail.UploadMaxMB }}{{ .Webmail.UploadMaxMB }}{{ else }}25{{ end }}M';
$config['max_message_size']    = '{{ if .Webmail.UploadMaxMB }}{{ .Webmail.UploadMaxMB }}{{ else }}25{{ end }}M';

// Display preferences.
$config['mail_pagesize']        = 50;
$config['addressbook_pagesize'] = 50;
$config['prefer_html']          = true;
$config['htmleditor']           = 4;
$config['preview_pane']         = true;
$config['list_cols']            = ['flag', 'status', 'subject', 'fromto', 'date', 'size'];

// Logging.
$config['log_driver'] = 'stdout';
$config['smtp_log']   = false;
$config['imap_debug'] = false;
