# Vectis Mail Server — Promtail configuration
# Generated by config engine — do not edit manually
# Scrapes Docker container logs and parses mail service formats.

server:
  http_listen_port: 9080

positions:
  filename: /tmp/positions.yaml

clients:
  - url: http://vectis-loki:3100/loki/api/v1/push

scrape_configs:
  # Scrape all Vectis containers via Docker socket.
  - job_name: vectis-containers
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 15s
        filters:
          - name: name
            values:
              - "vectis-.*"

    relabel_configs:
      # Extract container name as label.
      - source_labels: ["__meta_docker_container_name"]
        regex: "/(.*)"
        target_label: "container"
      # Extract service name from container name (strip "vectis-" prefix).
      - source_labels: ["__meta_docker_container_name"]
        regex: "/vectis-(.*)"
        target_label: "service"

    pipeline_stages:
      # API + Orchestrator: already structured JSON (slog output).
      - match:
          selector: '{service=~"api|orchestrator"}'
          stages:
            - json:
                expressions:
                  level: level
                  msg: msg
                  component: component
            - labels:
                level:
                component:

      # Postfix: parse syslog-style log lines.
      # Format: "Mon DD HH:MM:SS hostname postfix/smtpd[pid]: message"
      - match:
          selector: '{service="postfix"}'
          stages:
            - regex:
                expression: '(?P<process>postfix/\w+)\[(?P<pid>\d+)\]:\s+(?P<queue_id>[A-F0-9]+):\s+(?P<message>.*)'
            - labels:
                process:
            # Extract Postfix status from message.
            - regex:
                source: message
                expression: 'status=(?P<status>\w+)'
            - labels:
                status:

      # Dovecot: parse Dovecot log format.
      # Format: "Mon DD HH:MM:SS service(user)<pid><session>: message"
      - match:
          selector: '{service="dovecot"}'
          stages:
            - regex:
                expression: '(?P<dovecot_service>\w+)\((?P<user>[^)]*)\).*?:\s+(?P<message>.*)'
            - labels:
                dovecot_service:
                user:

      # Rspamd: parse Rspamd JSON log output.
      - match:
          selector: '{service="rspamd"}'
          stages:
            - json:
                expressions:
                  action: action
                  score: score
                  is_spam: is_spam
            - labels:
                action:
