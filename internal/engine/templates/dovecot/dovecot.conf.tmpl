# Vectis Mail Server — Dovecot configuration (2.4)
# Generated by config engine — do not edit manually

dovecot_config_version = 2.4.0
dovecot_storage_version = 2.4.0

protocols = imap pop3 lmtp sieve

# Logging
log_path = /dev/stderr
info_log_path = /dev/stdout

# SSL/TLS (2.4: ssl_cert/ssl_key renamed to ssl_server_cert_file/ssl_server_key_file)
ssl = required
ssl_server_cert_file = /etc/ssl/mail/fullchain.pem
ssl_server_key_file = /etc/ssl/mail/privkey.pem
ssl_min_protocol = TLSv1.2

# Mail location (2.4: mail_driver + mail_path replace the combined mail_location)
mail_driver = {{ mailDriver .Dovecot.MailLocation }}
mail_path = {{ mailPath .Dovecot.MailLocation }}
mail_home = {{ mailHome .Dovecot.MailLocation }}
mail_uid = 5000
mail_gid = 5000
first_valid_uid = 5000
last_valid_uid = 5000

# Authentication
auth_mechanisms = plain login

# SQL passdb/userdb (2.4 inline; kept in an included file for password isolation)
!include dovecot-sql.conf.ext

# Auth service for Postfix SASL
service auth {
    inet_listener auth {
        port = 12345
    }
}

# LMTP service (ADR-008: TCP port 24)
service lmtp {
    inet_listener lmtp {
        port = 24
    }
}

# IMAP service
service imap-login {
    inet_listener imaps {
        port = 993
        ssl = yes
    }
}

# POP3 service
service pop3-login {
    inet_listener pop3s {
        port = 995
        ssl = yes
    }
}

# ManageSieve
service managesieve-login {
    inet_listener sieve {
        port = 4190
    }
}

namespace inbox {
    inbox = yes
    separator = /

    mailbox Drafts {
        auto = subscribe
        special_use = \Drafts
    }
    mailbox Sent {
        auto = subscribe
        special_use = \Sent
    }
    mailbox "Sent Messages" {
        special_use = \Sent
    }
    mailbox Trash {
        auto = subscribe
        special_use = \Trash
    }
    mailbox Junk {
        auto = subscribe
        special_use = \Junk
    }
    mailbox Archive {
        auto = no
        special_use = \Archive
    }
}

# Quota (2.4: flat quota_* settings replace the plugin{} block).
# Per-user limit comes from the userdb quota_storage_size field (see
# dovecot-sql.conf.ext); this is the global default when the userdb omits it.
mail_plugins = quota
quota_driver = count
quota_storage_size = {{ .Dovecot.QuotaDefaultMB }} M

# Sieve (2.4: named sieve_script blocks replace the plugin{} sieve settings)
sieve_max_script_size = 1M
sieve_max_actions = 32
sieve_max_redirects = 4

sieve_script personal {
    type = personal
    driver = file
    path = ~/sieve
    active_path = ~/.dovecot.sieve
}
{{- if .Rspamd.SpamToJunkEnabled }}

# Global spam-filing script, run before any per-user sieve (type = before): files
# rspamd-tagged spam (X-Spam: Yes) into Junk so it never lands in INBOX. Opt out
# with rspamd.file_spam_to_junk: false. The Junk mailbox is auto-subscribed
# (\Junk special-use) in the namespace inbox block above. The .svbin is
# pre-compiled by the container entrypoint (2.4 requires global scripts to be
# pre-compiled; the mount is read-only at delivery time).
sieve_script spam_to_junk {
    type = before
    driver = file
    path = /etc/dovecot/sieve/spam-to-junk.sieve
}
{{- end }}

protocol imap {
    mail_plugins = quota
}

protocol lmtp {
    mail_plugins = quota sieve
}
