# Vectis Mail Server — Dovecot Dict Driver for Master User Auth
# Generated by config engine — do not edit manually
#
# Connects to Valkey to validate temporary impersonation credentials.

dict {
    vectis_master = redis:host={{ .Dovecot.ValkeyHost }}:port={{ .Dovecot.ValkeyPort }}:prefix=impersonate:
}

# Key format: impersonate:user@domain*vectis-admin
# Value: temporary password (plaintext, 30-minute TTL)
