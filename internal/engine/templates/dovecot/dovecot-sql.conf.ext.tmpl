# Vectis Mail Server — Dovecot SQL auth (2.4)
# Generated by config engine — do not edit manually
#
# Dovecot 2.4 replaced the external driver/connect/*_query format with inline
# settings: a named pgsql{} connection filter plus passdb sql{} / userdb sql{}
# blocks. Variables use the 2.4 %{user} syntax (old %u removed).

sql_driver = pgsql

pgsql main {
    host = {{ if .Cluster.PgBouncer.Enabled }}pgbouncer{{ else }}postgres{{ end }}
    parameters {
        port = {{ if .Cluster.PgBouncer.Enabled }}{{ if .Cluster.PgBouncer.ListenPort }}{{ .Cluster.PgBouncer.ListenPort }}{{ else }}6432{{ end }}{{ else }}5432{{ end }}
        dbname = {{ .Database.Name }}
        user = {{ .Database.DovecotUser }}
        password = {{ .Database.DovecotPassword }}
    }
}

# Short-lived server-side auth-token passdb (the native IMAP importer; later
# admin impersonation). Authenticates a target login against a hashed, expiring
# token row (migration 000023 / internal/repository/dovecot_auth_token.go), so a
# server-side feature can act AS a mailbox without that user's real password.
#
# 2.4 NOTE (validated on a live Dovecot 2.4.3 harness): this is a SECOND sql
# passdb, so it MUST carry a distinct filter name (auth_token) from the mailbox
# passdb below. Two unnamed `passdb sql {}` blocks silently collapse into one
# (only the last query survives), leaving this passdb inert. A custom filter
# name also disables 2.4's prefix-stripping shortcut, so each setting is written
# fully-qualified (passdb_sql_query, passdb_result_failure, ...) and the driver
# is selected explicitly with `driver = sql`.
#
# It is listed BEFORE the mailbox passdb and is engineered to be incapable of
# breaking normal auth: result_failure/result_internalfail = continue mean a
# missing/expired/mismatched token OR a DB error simply falls through to the
# real mailbox passdb below. Only a present, unexpired, matching token succeeds.
passdb auth_token {
    driver = sql
    passdb_default_password_scheme = ARGON2ID
    passdb_result_failure = continue
    passdb_result_internalfail = continue
    passdb_sql_query = SELECT password_hash AS password FROM dovecot_auth_tokens WHERE target_user = '%{user}' AND expires_at > NOW() ORDER BY created_at DESC LIMIT 1
}

passdb sql {
    default_password_scheme = ARGON2ID
    query = SELECT CONCAT(m.local_part, '@', d.name) AS user, m.password_hash AS password FROM mailboxes m JOIN domains d ON m.domain_id = d.id WHERE CONCAT(m.local_part, '@', d.name) = '%{user}' AND m.active = true AND d.active = true
}

# userdb supplies uid/gid and the per-user quota limit (quota_storage_size, the
# 2.4 replacement for the old userdb_quota_rule). home/mail_path come from the
# global mail_home/mail_path settings in dovecot.conf.
userdb sql {
    query = SELECT 5000 AS uid, 5000 AS gid, CONCAT(m.quota_mb::bigint, ' M') AS quota_storage_size FROM mailboxes m JOIN domains d ON m.domain_id = d.id WHERE CONCAT(m.local_part, '@', d.name) = '%{user}' AND m.active = true AND d.active = true
}
