# Vectis Mail Server — Traefik dynamic configuration
# Generated by config engine — do not edit manually
# File-based routing per ADR-017 (no Docker socket access for Traefik)

http:
  routers:
    # Auth endpoints — strictest rate limiting
    vectis-auth:
      rule: "Host(`{{ .Hostname }}`) && PathPrefix(`/api/v1/auth`)"
      service: vectis-api
      middlewares:
        - rate-limit-auth
      entryPoints:
        - websecure
{{ if eq .TLS.Provider "letsencrypt" }}
      tls:
        certResolver: letsencrypt
{{ else }}
      tls: {}
{{ end }}
      priority: 30

    # Mutating API endpoints (POST/PATCH/DELETE) — moderate rate limiting
    vectis-api-mutate:
      rule: "Host(`{{ .Hostname }}`) && PathPrefix(`/api/v1/`) && (Method(`POST`) || Method(`PATCH`) || Method(`DELETE`))"
      service: vectis-api
      middlewares:
        - rate-limit-mutate
      entryPoints:
        - websecure
{{ if eq .TLS.Provider "letsencrypt" }}
      tls:
        certResolver: letsencrypt
{{ else }}
      tls: {}
{{ end }}
      priority: 20

{{ if .Webmail.Enabled }}
    # Webmail (Roundcube) — standard rate limiting
    vectis-webmail:
      rule: "Host(`{{ .Hostname }}`) && PathPrefix(`/webmail`)"
      service: vectis-webmail
      middlewares:
        - rate-limit-api
        - webmail-strip-prefix
      entryPoints:
        - websecure
{{ if eq .TLS.Provider "letsencrypt" }}
      tls:
        certResolver: letsencrypt
{{ else }}
      tls: {}
{{ end }}
      priority: 15
{{ end }}
    # General API + UI — standard rate limiting
    vectis-api:
      rule: "Host(`{{ .Hostname }}`)"
      service: vectis-api
      middlewares:
        - rate-limit-api
      entryPoints:
        - websecure
{{ if eq .TLS.Provider "letsencrypt" }}
      tls:
        certResolver: letsencrypt
{{ else }}
      tls: {}
{{ end }}
      priority: 10

  middlewares:
    rate-limit-auth:
      rateLimit:
        average: {{ .RateLimits.AuthAverage }}
        burst: {{ .RateLimits.AuthBurst }}
    rate-limit-api:
      rateLimit:
        average: {{ .RateLimits.APIAverage }}
        burst: {{ .RateLimits.APIBurst }}
    rate-limit-mutate:
      rateLimit:
        average: {{ .RateLimits.MutateAverage }}
        burst: {{ .RateLimits.MutateBurst }}

{{ if .Webmail.Enabled }}
    webmail-strip-prefix:
      stripPrefix:
        prefixes:
          - "/webmail"
{{ end }}

  services:
    vectis-api:
      loadBalancer:
        servers:
          - url: "http://vectis-api:8080"
{{ if .Webmail.Enabled }}
    vectis-webmail:
      loadBalancer:
        servers:
          # apache image — single container, no separate nginx fronting it
          - url: "http://vectis-webmail:80"
{{ end }}
