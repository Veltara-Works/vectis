# Vectis Mail Server — Traefik dynamic configuration
# Generated by config engine — do not edit manually

http:
  routers:
    api:
      rule: "Host(`{{ .Hostname }}`) && PathPrefix(`/api`)"
      service: api
      entryPoints:
        - websecure
{{ if eq .TLS.Provider "letsencrypt" }}
      tls:
        certResolver: letsencrypt
{{ else }}
      tls: {}
{{ end }}
    admin-ui:
      rule: "Host(`{{ .Hostname }}`)"
      service: admin-ui
      entryPoints:
        - websecure
{{ if eq .TLS.Provider "letsencrypt" }}
      tls:
        certResolver: letsencrypt
{{ else }}
      tls: {}
{{ end }}

  services:
    api:
      loadBalancer:
        servers:
          - url: "http://api:8080"
    admin-ui:
      loadBalancer:
        servers:
          - url: "http://admin-ui:3000"
