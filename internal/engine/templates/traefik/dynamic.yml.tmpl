# Vectis Mail Server — Traefik dynamic configuration
# Generated by config engine — do not edit manually
# File-based routing per ADR-017 (no Docker socket access for Traefik)

http:
  routers:
    vectis-api:
      rule: "Host(`{{ .Hostname }}`)"
      service: vectis-api
      middlewares:
        - rate-limit-login
      entryPoints:
        - websecure
{{ if eq .TLS.Provider "letsencrypt" }}
      tls:
        certResolver: letsencrypt
{{ else }}
      tls: {}
{{ end }}

  services:
    vectis-api:
      loadBalancer:
        servers:
          - url: "http://vectis-api:8080"

  middlewares:
    rate-limit-login:
      rateLimit:
        average: 5
        burst: 10
        period: 1m
