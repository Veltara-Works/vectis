# Vectis Mail Server — Traefik static configuration
# Generated by config engine — do not edit manually

api:
  dashboard: false

ping: {}

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"

{{ if eq .TLS.Provider "letsencrypt" }}
certificatesResolvers:
  letsencrypt:
    acme:
      email: {{ .TLS.Email }}
      storage: /etc/traefik/acme/acme.json
      httpChallenge:
        entryPoint: web
{{ end }}

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true

log:
  level: {{ .Logging.Level | upper }}
  format: json
