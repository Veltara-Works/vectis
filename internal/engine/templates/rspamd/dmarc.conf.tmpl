# Vectis Mail Server — Rspamd DMARC module
# Generated by config engine — do not edit manually
#
# rspamd.enforce_dmarc (default true): act on the sender domain's published
# DMARC policy rather than only scoring it. Without this, mail forging a
# p=reject domain only gains DMARC_POLICY_REJECT points: found 2026-10-04,
# where a dozen phishing messages forging the operator's own p=reject domain
# had landed in Junk instead of being refused.
#
# The module sets these as the LEAST action ('least'), so a higher score can
# still escalate. It never checks authenticated submission or local networks
# (config_check_local_or_authed defaults), so outbound mail is unaffected.
{{- if .Rspamd.DMARCEnforced }}
actions {
  reject = "reject";
  quarantine = "add header";
}
{{- else }}
# enforcement off: DMARC failures are scored only
{{- end }}
