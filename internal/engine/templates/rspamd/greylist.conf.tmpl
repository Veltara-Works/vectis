# Vectis Mail Server — Rspamd greylist module
# Generated by config engine — do not edit manually
#
# Follows rspamd.greylist_enabled (default false). This must switch the MODULE,
# not just the action: with the greylist action unset or null, the greylist
# plugin skips its minimum-score check (task:get_metric_threshold returns nil)
# and greylists EVERY message from an unseen sender. Enabling the module with
# no threshold would be worse than leaving greylisting off.
#
# Per-domain overrides (Pro) live in settings.conf and can only disable the
# module for a domain's recipients; they have no effect while this is false.
enabled = {{ if .Rspamd.GreylistEnabled }}true{{ else }}false{{ end }};
