# Vectis Mail Server — Rspamd per-domain settings overrides
# Generated by config engine — do not edit manually.
#
# This file declares one settings block per domain that has at least one
# Pro per-domain spam knob set (reject_threshold or greylist_enabled).
# Domains with no overrides fall through to the global thresholds in
# actions.conf and the default greylist module behaviour.
#
# When a recipient envelope matches `rcpt`, the `apply` block overrides
# the action thresholds and/or disables greylisting for that message.
{{ range .Domains }}{{ if or (hasFloat .RejectThreshold) (hasBool .GreylistEnabled) }}
domain_{{ .Name }} {
  rcpt = "@{{ .Name }}";
  apply {
{{- if hasFloat .RejectThreshold }}
    actions {
      reject = {{ printf "%.1f" (derefFloat .RejectThreshold) }};
    }
{{- end }}
{{- if and (hasBool .GreylistEnabled) (not (derefBool .GreylistEnabled)) }}
    plugins_disabled = ["greylist"];
{{- end }}
  }
}
{{ end }}{{ end }}
