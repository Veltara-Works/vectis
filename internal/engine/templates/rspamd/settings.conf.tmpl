# Vectis Mail Server — Rspamd per-domain settings overrides
# Generated by config engine — do not edit manually.
#
# One settings block per domain that needs one: a Pro reject_threshold
# override, and/or greylisting switched off for its recipients
# (GreylistOffForDomain: the greylist module is loaded for some domain, but this
# domain's effective setting is off). Other domains fall through to the global
# thresholds in actions.conf.
#
# Greylisting is switched off per domain with symbols_disabled on the plugin's
# two symbols, plus a null greylist action so a score above the global greylist
# threshold can't end as action "greylist" with no plugin to downgrade it.
# (Before 2026-10-04 this used `plugins_disabled`, which is not an rspamd
# settings key and was silently ignored.)
{{ range .Domains }}{{ $grey := $.GreylistOffForDomain . }}{{ if or (hasFloat .RejectThreshold) $grey }}
domain_{{ .Name }} {
  rcpt = "@{{ .Name }}";
  apply {
{{- if or (hasFloat .RejectThreshold) $grey }}
    actions {
{{- if hasFloat .RejectThreshold }}
      reject = {{ printf "%.1f" (derefFloat .RejectThreshold) }};
{{- end }}
{{- if $grey }}
      greylist = null;
{{- end }}
    }
{{- end }}
{{- if $grey }}
    symbols_disabled = ["GREYLIST_CHECK", "GREYLIST_SAVE"];
{{- end }}
  }
}
{{ end }}{{ end }}
