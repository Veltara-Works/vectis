# Vectis Mail Server — Rspamd RBL overrides (Spamhaus DQS, #260)
# Generated by config engine — do not edit manually
#
# Merged into rspamd's stock rbl module (local.d, duplicate=merge), so only the
# zones change: return codes, symbols and scores stay rspamd's own.
{{- if .SpamhausDQSKey }}
#
# Spamhaus lookups go to this operator's own Data Query Service account
# (secrets.yaml rspamd.spamhaus_dqs_key) instead of the public mirrors.
rbls {
  spamhaus {
    rbl = "{{ .SpamhausDQSKey }}.zen.dq.spamhaus.net";
  }
  DBL {
    rbl = "{{ .SpamhausDQSKey }}.dbl.dq.spamhaus.net";
  }
  # Off by default in rspamd (privacy); if enabled, it uses DQS too.
  SPAMHAUS_ZEN_URIBL {
    rbl = "{{ .SpamhausDQSKey }}.zen.dq.spamhaus.net";
  }
}
{{- else }}
#
# No Spamhaus DQS key is configured, so rspamd queries Spamhaus's public
# mirrors (zen.spamhaus.org, dbl.spamhaus.org). Spamhaus allows those only for
# non-commercial use at modest volumes. If you run this server for a business,
# register your own DQS key (free or paid, depending on your eligibility with
# Spamhaus) and set rspamd.spamhaus_dqs_key in /etc/vectis/secrets.yaml.
{{- end }}
