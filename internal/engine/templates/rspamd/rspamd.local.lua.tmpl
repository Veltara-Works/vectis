-- Vectis Mail Server — Rspamd Lua extension (Advanced Spam, Pro)
-- Generated by config engine — do not edit manually.
--
-- Loads four per-recipient-domain map files (allow/block × email/domain
-- scope) and runs a single prefilter that consults them with a composite
-- key of "<recipient_domain>:<sender_addr_or_domain>". Hits short-circuit
-- delivery via task:set_pre_result so they bypass the normal scoring path.
--
-- All map files are unconditionally added; an empty file simply means no
-- hits will fire. Free-tier installs with no Pro license still ship empty
-- map files so the prefilter remains a no-op rather than failing to load.

local rspamd_logger = require "rspamd_logger"

local maps = {}
maps.block_email  = rspamd_config:add_map{ url = '/etc/rspamd/local.d/maps/block_email.map',  type = 'set', description = 'Vectis per-domain block list (email scope)' }
maps.block_domain = rspamd_config:add_map{ url = '/etc/rspamd/local.d/maps/block_domain.map', type = 'set', description = 'Vectis per-domain block list (sender domain scope)' }
maps.allow_email  = rspamd_config:add_map{ url = '/etc/rspamd/local.d/maps/allow_email.map',  type = 'set', description = 'Vectis per-domain allow list (email scope)' }
maps.allow_domain = rspamd_config:add_map{ url = '/etc/rspamd/local.d/maps/allow_domain.map', type = 'set', description = 'Vectis per-domain allow list (sender domain scope)' }

local function lookup(map, key)
  if not map then return false end
  -- rspamd `set` map: get_key returns boolean true on hit, false on miss.
  -- A non-strict truthiness check would also match every miss because
  -- `false` is not nil — so we compare for explicit `true`.
  -- Verified live on rspamd 3.10.2 during v0.1.1 → v0.1.2 fix walk.
  return map:get_key(key) == true
end

local function principal_rcpt_domain(task)
  local rcpt = task:get_principal_recipient()
  if not rcpt then return nil end
  rcpt = string.lower(rcpt)
  local at = string.find(rcpt, '@', 1, true)
  if not at then return nil end
  return string.sub(rcpt, at + 1)
end

local function smtp_from(task)
  local from = task:get_from('smtp')
  if not from or #from < 1 then return nil, nil end
  local addr = from[1].addr
  local dom = from[1].domain
  if addr then addr = string.lower(addr) end
  if dom  then dom  = string.lower(dom)  end
  return addr, dom
end

rspamd_config:register_symbol{
  name = 'VECTIS_SPAM_LISTS',
  type = 'prefilter',
  priority = 10,
  callback = function(task)
    local rcpt_domain = principal_rcpt_domain(task)
    if not rcpt_domain then return end

    local from_addr, from_domain = smtp_from(task)
    if not from_addr and not from_domain then return end

    local key_email  = from_addr   and (rcpt_domain .. ':' .. from_addr)   or nil
    local key_domain = from_domain and (rcpt_domain .. ':' .. from_domain) or nil

    -- Block list takes precedence over allow list for the same recipient.
    -- Email-scope hits take precedence over domain-scope hits within a list.
    if key_email and lookup(maps.block_email, key_email) then
      task:insert_result('VECTIS_BLOCK_EMAIL', 1.0, from_addr)
      task:set_pre_result('reject', 'Sender is on the recipient block list')
      rspamd_logger.infox(task, 'vectis: block-email hit rcpt=%s from=%s', rcpt_domain, from_addr)
      return
    end
    if key_domain and lookup(maps.block_domain, key_domain) then
      task:insert_result('VECTIS_BLOCK_DOMAIN', 1.0, from_domain)
      task:set_pre_result('reject', 'Sender domain is on the recipient block list')
      rspamd_logger.infox(task, 'vectis: block-domain hit rcpt=%s from_domain=%s', rcpt_domain, from_domain)
      return
    end
    if key_email and lookup(maps.allow_email, key_email) then
      task:insert_result('VECTIS_ALLOW_EMAIL', 1.0, from_addr)
      task:set_pre_result('accept', 'Sender is on the recipient allow list')
      rspamd_logger.infox(task, 'vectis: allow-email hit rcpt=%s from=%s', rcpt_domain, from_addr)
      return
    end
    if key_domain and lookup(maps.allow_domain, key_domain) then
      task:insert_result('VECTIS_ALLOW_DOMAIN', 1.0, from_domain)
      task:set_pre_result('accept', 'Sender domain is on the recipient allow list')
      rspamd_logger.infox(task, 'vectis: allow-domain hit rcpt=%s from_domain=%s', rcpt_domain, from_domain)
      return
    end
  end,
}
-- VECTIS_RCPT_DOMAIN_SPOOF
--
-- Fires when the From DISPLAY NAME references the recipient's own domain while
-- the actual From domain is not that domain. This is the classic role-address
-- phish: mail to hello@example.com arriving as
--     From: "example.com Support Team" <server@throwaway.cc>
--
-- WHY A SCORING RULE AND NOT A THRESHOLD CHANGE: this class scores NEGATIVE on
-- reputation alone. Observed live on prod 2026-08-31 — a phish impersonating
-- "vectismail.com Support Team" from a Russian ASN scored -0.40, because valid
-- SPF and DMARC on the attacker's OWN throwaway domain earn rspamd bonuses
-- (DMARC_POLICY_ALLOW_WITH_FAILURES -0.50, R_SPF_ALLOW -0.20). Authentication
-- no longer signals legitimacy; lowering add_header cannot catch this.
--
-- Deliberately keyed on the RECIPIENT's domain, not a configured brand list, so
-- it works for every hosted tenant with no per-install configuration.
--
-- Does NOT fire when the sender is aligned with the recipient domain (genuine
-- intra-domain mail) or on a subdomain of it.

local function rcpt_domain(task)
  local rcpt = task:get_principal_recipient()
  if not rcpt then return nil end
  local at = string.find(rcpt, '@', 1, true)
  if not at then return nil end
  return string.lower(string.sub(rcpt, at + 1))
end

rspamd_config:register_symbol{
  name = 'VECTIS_RCPT_DOMAIN_SPOOF',
  score = 7.0,
  description = 'From display name impersonates the recipient domain from an unaligned sender',
  callback = function(task)
    local rd = rcpt_domain(task)
    if not rd then return false end

    local from = task:get_from('mime')
    if not from or #from < 1 then return false end
    local dn = from[1].name
    if not dn then return false end
    dn = string.lower(dn)

    local fd = from[1].domain
    if fd then fd = string.lower(fd) end

    -- Aligned sender (or a subdomain of the recipient domain) is legitimate.
    if fd and (fd == rd or string.sub(fd, -(#rd + 1)) == '.' .. rd) then
      return false
    end

    -- Bare label as well as the FQDN: "vectismail" and "vectismail.com".
    local label = string.match(rd, '^([^.]+)%.')

    -- plain find, no pattern magic — the '.' in a domain must stay literal.
    if string.find(dn, rd, 1, true) then
      return true, 1.0, rd
    end
    if label and #label >= 4 and string.find(dn, label, 1, true) then
      return true, 1.0, label
    end

    return false
  end,
}
