-- Vectis Mail Server — Rspamd Lua extension (Advanced Spam, Pro)
-- Generated by config engine — do not edit manually.
--
-- Loads four per-recipient-domain map files (allow/block × email/domain
-- scope) and consults them with a composite key of
-- "<recipient_domain>:<sender_addr_or_domain>".
--
-- BLOCK runs as a PREFILTER and short-circuits delivery via
-- task:set_pre_result('reject') — rejecting early is cheap and fail-safe.
--
-- ALLOW runs as a POSTFILTER and applies a large negative score. It must NOT
-- be a prefilter: an `accept` pre-result skips every remaining symbol,
-- including antivirus and SPF/DKIM/DMARC, which turned an allow entry into a
-- forgeable bypass of all filtering. See VECTIS_ALLOW_LISTS below.
--
-- All map files are unconditionally added; an empty file simply means no
-- hits will fire. Free-tier installs with no Pro license still ship empty
-- map files so the prefilter remains a no-op rather than failing to load.

local rspamd_logger = require "rspamd_logger"

local maps = {}
maps.block_email  = rspamd_config:add_map{ url = '/etc/rspamd/local.d/maps/block_email.map',  type = 'set', description = 'Vectis per-domain block list (email scope)' }
maps.block_domain = rspamd_config:add_map{ url = '/etc/rspamd/local.d/maps/block_domain.map', type = 'set', description = 'Vectis per-domain block list (sender domain scope)' }
maps.allow_email  = rspamd_config:add_map{ url = '/etc/rspamd/local.d/maps/allow_email.map',  type = 'set', description = 'Vectis per-domain allow list (email scope)' }
maps.allow_domain = rspamd_config:add_map{ url = '/etc/rspamd/local.d/maps/allow_domain.map', type = 'set', description = 'Vectis per-domain allow list (sender domain scope)' }

local function lookup(map, key)
  if not map then return false end
  -- rspamd `set` map: get_key returns boolean true on hit, false on miss.
  -- A non-strict truthiness check would also match every miss because
  -- `false` is not nil — so we compare for explicit `true`.
  -- Verified live on rspamd 3.10.2 during v0.1.1 → v0.1.2 fix walk.
  return map:get_key(key) == true
end

local function principal_rcpt_domain(task)
  local rcpt = task:get_principal_recipient()
  if not rcpt then return nil end
  rcpt = string.lower(rcpt)
  local at = string.find(rcpt, '@', 1, true)
  if not at then return nil end
  return string.sub(rcpt, at + 1)
end

local function smtp_from(task)
  local from = task:get_from('smtp')
  if not from or #from < 1 then return nil, nil end
  local addr = from[1].addr
  local dom = from[1].domain
  if addr then addr = string.lower(addr) end
  if dom  then dom  = string.lower(dom)  end
  return addr, dom
end

rspamd_config:register_symbol{
  name = 'VECTIS_SPAM_LISTS',
  type = 'prefilter',
  priority = 10,
  callback = function(task)
    local rcpt_domain = principal_rcpt_domain(task)
    if not rcpt_domain then return end

    local from_addr, from_domain = smtp_from(task)
    if not from_addr and not from_domain then return end

    local key_email  = from_addr   and (rcpt_domain .. ':' .. from_addr)   or nil
    local key_domain = from_domain and (rcpt_domain .. ':' .. from_domain) or nil

    -- Block list takes precedence over allow list for the same recipient.
    -- Email-scope hits take precedence over domain-scope hits within a list.
    if key_email and lookup(maps.block_email, key_email) then
      task:insert_result('VECTIS_BLOCK_EMAIL', 1.0, from_addr)
      task:set_pre_result('reject', 'Sender is on the recipient block list')
      rspamd_logger.infox(task, 'vectis: block-email hit rcpt=%s from=%s', rcpt_domain, from_addr)
      return
    end
    if key_domain and lookup(maps.block_domain, key_domain) then
      task:insert_result('VECTIS_BLOCK_DOMAIN', 1.0, from_domain)
      task:set_pre_result('reject', 'Sender domain is on the recipient block list')
      rspamd_logger.infox(task, 'vectis: block-domain hit rcpt=%s from_domain=%s', rcpt_domain, from_domain)
      return
    end
    -- NOTE: the ALLOW path deliberately does NOT live here. See
    -- VECTIS_ALLOW_LISTS below — honouring an allow entry from a prefilter
    -- bypasses antivirus and trusts a forgeable envelope.
  end,
}
-- VECTIS_RCPT_DOMAIN_SPOOF
--
-- Fires when the From DISPLAY NAME references the recipient's own domain while
-- the actual From domain is not that domain. This is the classic role-address
-- phish: mail to hello@example.com arriving as
--     From: "example.com Support Team" <server@throwaway.cc>
--
-- WHY A SCORING RULE AND NOT A THRESHOLD CHANGE: this class scores NEGATIVE on
-- reputation alone. Observed live on prod 2026-08-31 — a phish impersonating
-- "vectismail.com Support Team" from a Russian ASN scored -0.40, because valid
-- SPF and DMARC on the attacker's OWN throwaway domain earn rspamd bonuses
-- (DMARC_POLICY_ALLOW_WITH_FAILURES -0.50, R_SPF_ALLOW -0.20). Authentication
-- no longer signals legitimacy; lowering add_header cannot catch this.
--
-- Deliberately keyed on the RECIPIENT's domain, not a configured brand list, so
-- it works for every hosted tenant with no per-install configuration.
--
-- Does NOT fire when the sender is aligned with the recipient domain (genuine
-- intra-domain mail) or on a subdomain of it.

rspamd_config:register_symbol{
  name = 'VECTIS_RCPT_DOMAIN_SPOOF',
  score = 7.0,
  description = 'From display name impersonates the recipient domain from an unaligned sender',
  callback = function(task)
    local rd = principal_rcpt_domain(task)
    if not rd then return false end

    local from = task:get_from('mime')
    if not from or #from < 1 then return false end
    local dn = from[1].name
    if not dn then return false end
    dn = string.lower(dn)

    local fd = from[1].domain
    if fd then fd = string.lower(fd) end

    -- Aligned sender (or a subdomain of the recipient domain) is legitimate.
    if fd and (fd == rd or string.sub(fd, -(#rd + 1)) == '.' .. rd) then
      return false
    end

    -- Bare label as well as the FQDN: "vectismail" and "vectismail.com".
    local label = string.match(rd, '^([^.]+)%.')

    -- plain find, no pattern magic — the '.' in a domain must stay literal.
    if string.find(dn, rd, 1, true) then
      return true, 1.0, rd
    end
    if label and #label >= 4 and string.find(dn, label, 1, true) then
      return true, 1.0, label
    end

    return false
  end,
}

-- Allow list — POSTFILTER, deliberately not a prefilter.
--
-- SECURITY (fixed 2026-08-31): this previously ran in the prefilter above and
-- called task:set_pre_result('accept'), which was wrong in two ways.
--
--   1. `accept` short-circuits the ENTIRE scan, including the CLAM_VIRUS
--      antivirus symbol. An allow entry therefore disabled malware scanning for
--      that sender, not just spam scoring.
--   2. It keyed on task:get_from('smtp') — the ENVELOPE sender, which is
--      trivially forgeable — and ran BEFORE SPF/DKIM/DMARC were evaluated,
--      because those are ordinary symbols that the `accept` skipped. Anyone
--      could set MAIL FROM to an allowlisted domain and bypass all filtering.
--
-- Now: runs as a postfilter, so authentication and antivirus have already been
-- evaluated; REQUIRES the matched identity to be authenticated; REFUSES to
-- act if a virus was found; and applies a large negative score instead of
-- accepting outright, so an allowlisted sender that later starts sending
-- malware is still caught.
--
-- Authentication required depends on which identity matched:
--   * envelope (SMTP MAIL FROM) match  -> R_SPF_ALLOW must have fired
--   * header From match                -> DMARC_POLICY_ALLOW must have fired
--
-- Matching the header From as well as the envelope also fixes a usability trap:
-- bulk senders commonly use a different bounce domain, e.g.
--   From: contacts@email.everyday.com.au
--   Return-Path: bounce-...@bounce.email.woolworthsrewards.com.au
-- so an operator allowlisting the domain they can SEE previously got silence.

local function mime_from_domain(task)
  local f = task:get_from('mime')
  if not f or #f < 1 or not f[1].domain then return nil end
  return string.lower(f[1].domain)
end

rspamd_config:register_symbol{
  name = 'VECTIS_ALLOW_LISTS',
  type = 'postfilter',
  priority = 10,
  callback = function(task)
    local rcpt_domain = principal_rcpt_domain(task)
    if not rcpt_domain then return end

    -- Never rescue a message carrying malware, whatever the list says.
    if task:get_symbol('CLAM_VIRUS') then
      rspamd_logger.infox(task, 'vectis: allow list NOT applied — CLAM_VIRUS present')
      return
    end

    local env_addr, env_domain = smtp_from(task)
    local hdr_domain = mime_from_domain(task)

    -- get_symbol returns a table on hit and nil on miss, so plain truthiness is
    -- correct here. Deliberately NOT `~= nil`: that idiom is banned in this file
    -- because for a `set` MAP get_key returns false on a miss, and `false ~= nil`
    -- is true — which would match every key. Keeping one rule avoids the trap.
    local spf_ok   = task:get_symbol('R_SPF_ALLOW')
    local dmarc_ok = task:get_symbol('DMARC_POLICY_ALLOW')

    local function hit(map, ident, authed)
      if not ident or not authed then return false end
      return lookup(map, rcpt_domain .. ':' .. ident)
    end

    local matched, why
    if hit(maps.allow_email, env_addr, spf_ok) then
      matched, why = env_addr, 'envelope address (SPF-verified)'
    elseif hit(maps.allow_domain, env_domain, spf_ok) then
      matched, why = env_domain, 'envelope domain (SPF-verified)'
    elseif hit(maps.allow_domain, hdr_domain, dmarc_ok) then
      matched, why = hdr_domain, 'header From domain (DMARC-verified)'
    end

    if not matched then
      -- Log the near-miss: an unauthenticated match is the interesting case,
      -- because silence would otherwise look identical to "not on the list".
      if (env_addr and lookup(maps.allow_email, rcpt_domain .. ':' .. env_addr) and not spf_ok)
        or (env_domain and lookup(maps.allow_domain, rcpt_domain .. ':' .. env_domain) and not spf_ok)
        or (hdr_domain and lookup(maps.allow_domain, rcpt_domain .. ':' .. hdr_domain) and not dmarc_ok) then
        rspamd_logger.infox(task, 'vectis: allow list matched but sender NOT authenticated — ignoring (rcpt=%s spf=%s dmarc=%s)',
          rcpt_domain, tostring(spf_ok), tostring(dmarc_ok))
      end
      return
    end

    task:insert_result('VECTIS_ALLOW_LIST', 1.0, matched, why)
    rspamd_logger.infox(task, 'vectis: allow hit rcpt=%s ident=%s via=%s', rcpt_domain, matched, why)
  end,
}

-- Large negative score rather than a pre-result `accept`: it clears the
-- add_header and reject thresholds for ordinary scoring, but a virus or another
-- very high-scoring signal can still carry the message over reject. Allowing is
-- a strong hint, not an override.
rspamd_config:set_metric_symbol({
  name = 'VECTIS_ALLOW_LIST',
  score = -15.0,
  description = 'Sender is on the recipient allow list and passed authentication',
})

-- VECTIS_DMARC_EXCEPTIONS (#265)
--
-- DMARC enforcement (rspamd.enforce_dmarc) rejects mail that fails DMARC for a
-- p=reject domain. Some legitimate senders publish p=reject but send from a
-- platform their own SPF doesn't list, without DKIM, so every message fails.
-- The allow list can't help (it only applies to authenticated senders, and
-- must stay that way). A DMARC exception lets one header-From domain through
-- DMARC enforcement for one recipient domain, but ONLY from a stated sending
-- network: an IP, a CIDR, or an exact hostname. (The API refuses hostname
-- suffixes; the leading-"." form below only matters for a hand-edited map.)
-- A hostname is matched against the client's name, which an attacker controls
-- for their own IP (reverse DNS), so it is only trusted after this rule
-- FORWARD-CONFIRMS it: the name's A/AAAA records must include the connecting
-- IP. rspamd may look the reverse name up itself when Postfix hasn't passed a
-- verified one, so we don't rely on Postfix's check. Mail claiming the domain
-- from anywhere else is still rejected.
--
-- On a match, only the DMARC check is switched off for that message:
-- SPF, DKIM, antivirus and every other rule still run and score.
--
-- Map lines: "<recipient-domain>:<header-From domain> <network>"; one line
-- per network, so it's loaded through a callback into a table of lists.

local rspamd_ip = require "rspamd_ip"

local dmarc_exceptions = {}

local function parse_dmarc_exceptions(data)
  local t = {}
  for line in string.gmatch(tostring(data or ''), '[^\r\n]+') do
    line = string.gsub(line, '#.*$', '')
    local key, net = string.match(line, '^%s*(%S+)%s+(%S+)%s*$')
    if key and net then
      key = string.lower(key)
      local addr, bits = string.match(net, '^([^/]+)/(%d+)$')
      addr = addr or net
      -- Decide IP vs hostname by syntax: rspamd_ip.from_string() also
      -- "parses" a hostname such as ".ipv4.example.net" and reports it
      -- valid, which would turn every hostname entry into a dead IP entry.
      local looks_ip = string.match(addr, '^%d+%.%d+%.%d+%.%d+$') or string.find(addr, ':', 1, true)
      local ip = looks_ip and rspamd_ip.from_string(addr) or nil
      local entry
      if ip and ip:is_valid() and (ip:get_version() == 4 or ip:get_version() == 6) then
        local max = (ip:get_version() == 6) and 128 or 32
        entry = { ip = ip, bits = tonumber(bits) or max, text = net }
      elseif not looks_ip and not bits then
        entry = { host = string.lower(net), text = net }
      end
      if entry then
        t[key] = t[key] or {}
        table.insert(t[key], entry)
      else
        rspamd_logger.warnx(rspamd_config, 'vectis: ignoring malformed DMARC exception network %s for %s', net, key)
      end
    end
  end
  dmarc_exceptions = t
end

rspamd_config:add_map{
  url = '/etc/rspamd/local.d/maps/dmarc_exceptions.map',
  type = 'callback',
  description = 'Vectis per-domain DMARC exceptions (#265)',
  callback = parse_dmarc_exceptions,
}

local function dmarc_exception_ip_matches(from, entry)
  if not from or not from:is_valid() or from:get_version() ~= entry.ip:get_version() then
    return false
  end
  return from:apply_mask(entry.bits):to_string() == entry.ip:apply_mask(entry.bits):to_string()
end

-- Name match only; the caller forward-confirms the name before trusting it.
local function dmarc_exception_host_matches(host, entry)
  if not host then return false end
  if string.sub(entry.host, 1, 1) == '.' then
    return #host > #entry.host and string.sub(host, -#entry.host) == entry.host
  end
  return host == entry.host
end

rspamd_config:register_symbol{
  name = 'VECTIS_DMARC_EXCEPTIONS',
  type = 'prefilter',
  priority = 9,
  callback = function(task)
    if next(dmarc_exceptions) == nil then return end
    local hdr_domain = mime_from_domain(task)
    if not hdr_domain then return end

    -- One message is one DMARC decision, so the check is only switched off
    -- when EVERY recipient domain has an exception for this sender that
    -- matches where the message came from. A message to an excepted and a
    -- non-excepted domain is still judged by DMARC for all of them.
    local rcpts = task:get_recipients('smtp')
    if not rcpts or #rcpts == 0 then return end
    local from_ip = task:get_from_ip()
    local host = task:get_hostname()
    if host == 'unknown' then host = nil end
    if host then host = string.lower(host) end

    local function apply(via)
      task:disable_symbol('DMARC_CHECK')
      task:insert_result('VECTIS_DMARC_EXCEPTION', 1.0, hdr_domain, via)
      rspamd_logger.infox(task, 'vectis: DMARC exception applied from=%s via=%s', hdr_domain, via)
    end

    local via, need_confirm, seen, any = nil, false, {}, false
    for _, r in ipairs(rcpts) do
      local rd = r.domain and string.lower(r.domain)
      if not rd or rd == '' then return end
      if not seen[rd] then
        seen[rd] = true
        local entries = dmarc_exceptions[rd .. ':' .. hdr_domain]
        local by_ip, by_host
        if entries then
          any = true
          for _, e in ipairs(entries) do
            if e.ip and dmarc_exception_ip_matches(from_ip, e) then by_ip = e.text; break end
            if e.host and not by_host and dmarc_exception_host_matches(host, e) then by_host = e.text end
          end
        end
        if by_ip then
          via = via or by_ip
        elseif by_host then
          need_confirm = true
          via = via or by_host
        else
          if any then
            -- The near-miss matters: an exception exists, but not for this
            -- network, or not for every recipient domain, so DMARC decides.
            rspamd_logger.infox(task, 'vectis: DMARC exception for %s NOT applied — rcpt domain %s has no matching exception (ip=%s host=%s)',
              hdr_domain, rd, tostring(from_ip), tostring(host))
          end
          return
        end
      end
    end

    if not need_confirm then
      apply(via)
      return
    end

    -- A hostname match only counts if the name resolves back to the client.
    local qtype = (from_ip and from_ip:get_version() == 6) and 'aaaa' or 'a'
    task:get_resolver():resolve(qtype, {
      task = task,
      name = host,
      forced = true,
      callback = function(_, _, results, err)
        if results then
          for _, addr in ipairs(results) do
            if tostring(addr) == tostring(from_ip) then
              apply(via .. ' (forward-confirmed)')
              return
            end
          end
        end
        rspamd_logger.infox(task, 'vectis: DMARC exception for %s NOT applied — host %s does not resolve to %s (%s)',
          hdr_domain, host, tostring(from_ip), tostring(err))
      end,
    })
  end,
}

rspamd_config:set_metric_symbol({
  name = 'VECTIS_DMARC_EXCEPTION',
  score = 0.0,
  description = 'DMARC check skipped: sender domain and network are on the recipient DMARC exception list',
})

-- VECTIS_DMARC_REJECT_LOG (#265 follow-up)
--
-- A message rejected by DMARC enforcement leaves no trace but an SMTP log line,
-- so an operator can't see a legitimate sender with broken DNS being turned
-- away. This records each one in Valkey for the admin UI's "Rejected by DMARC"
-- view (GET /domains/{id}/dmarc-rejections), which is where a DMARC exception
-- gets added from.
--
-- It runs after the action is final (idempotent: it can't change the result)
-- and only for a reject that DMARC took part in: DMARC_POLICY_REJECT plus the
-- final action reject. It stores no content: domains, the header From address,
-- the client IP and name, and which SPF/DKIM symbols fired. One sorted set,
-- scored by time, trimmed to 30 days and 5000 entries on every write.

local lua_redis = require "lua_redis"
local rspamd_util = require "rspamd_util"
local ucl = require "ucl"

local dmarc_reject_key = 'vectis_dmarc_rejects'
local dmarc_reject_keep_secs = 30 * 86400
local dmarc_reject_max = 5000
local dmarc_reject_redis = lua_redis.parse_redis_server('vectis_dmarc_rejects')

-- ZADD + trim in one round trip, so the set can't grow past its bounds.
local dmarc_reject_script = [[
redis.call('ZADD', KEYS[1], ARGV[1], ARGV[2])
redis.call('ZREMRANGEBYSCORE', KEYS[1], '-inf', tonumber(ARGV[1]) - tonumber(ARGV[3]))
redis.call('ZREMRANGEBYRANK', KEYS[1], 0, -(tonumber(ARGV[4]) + 1))
redis.call('EXPIRE', KEYS[1], ARGV[3])
]]

local function first_symbol(task, names)
  for _, n in ipairs(names) do
    if task:has_symbol(n) then return n end
  end
  return 'none'
end

if dmarc_reject_redis then
  rspamd_config:register_symbol{
    name = 'VECTIS_DMARC_REJECT_LOG',
    type = 'idempotent',
    callback = function(task)
      if not task:has_symbol('DMARC_POLICY_REJECT') then return end
      local action = task:get_metric_action()
      if action ~= 'reject' then return end

      local hdr_domain = mime_from_domain(task)
      if not hdr_domain then return end
      local mf = task:get_from('mime')
      local ef = task:get_from('smtp')
      local rcpt_domains, seen = {}, {}
      for _, r in ipairs(task:get_recipients('smtp') or {}) do
        local d = r.domain and string.lower(r.domain)
        if d and d ~= '' and not seen[d] then
          seen[d] = true
          table.insert(rcpt_domains, d)
        end
      end
      if #rcpt_domains == 0 then return end
      local host = task:get_hostname()
      if host == 'unknown' then host = nil end
      local now = math.floor(rspamd_util.get_time())

      local entry = ucl.to_format({
        t = now,
        id = task:get_queue_id() or task:get_uid(),
        from = mf and mf[1] and mf[1].addr and string.lower(mf[1].addr) or hdr_domain,
        from_domain = hdr_domain,
        env_from_domain = ef and ef[1] and ef[1].domain and string.lower(ef[1].domain) or '',
        ip = tostring(task:get_from_ip() or ''),
        host = host and string.lower(host) or '',
        rcpt_domains = rcpt_domains,
        spf = first_symbol(task, { 'R_SPF_ALLOW', 'R_SPF_FAIL', 'R_SPF_SOFTFAIL', 'R_SPF_NEUTRAL', 'R_SPF_DNSFAIL', 'R_SPF_PERMFAIL', 'R_SPF_NA' }),
        dkim = first_symbol(task, { 'R_DKIM_ALLOW', 'R_DKIM_REJECT', 'R_DKIM_TEMPFAIL', 'R_DKIM_PERMFAIL', 'R_DKIM_NA' }),
      }, 'json-compact')

      local ok = lua_redis.redis_make_request(task, dmarc_reject_redis, dmarc_reject_key, true,
        function(err)
          if err then
            rspamd_logger.warnx(task, 'vectis: could not record DMARC rejection of %s: %s', hdr_domain, err)
          end
        end,
        'EVAL', { dmarc_reject_script, '1', dmarc_reject_key, tostring(now), entry,
                  tostring(dmarc_reject_keep_secs), tostring(dmarc_reject_max) })
      if not ok then
        rspamd_logger.warnx(task, 'vectis: could not record DMARC rejection of %s: no Redis connection', hdr_domain)
      end
    end,
  }
else
  rspamd_logger.warnx(rspamd_config, 'vectis: no Redis configured; DMARC rejections will not be recorded')
end
