-- Vectis Mail Server — Rspamd Lua extension (Advanced Spam, Pro)
-- Generated by config engine — do not edit manually.
--
-- Loads four per-recipient-domain map files (allow/block × email/domain
-- scope) and consults them with a composite key of
-- "<recipient_domain>:<sender_addr_or_domain>".
--
-- BLOCK runs as a PREFILTER and short-circuits delivery via
-- task:set_pre_result('reject') — rejecting early is cheap and fail-safe.
--
-- ALLOW runs as a POSTFILTER and applies a large negative score. It must NOT
-- be a prefilter: an `accept` pre-result skips every remaining symbol,
-- including antivirus and SPF/DKIM/DMARC, which turned an allow entry into a
-- forgeable bypass of all filtering. See VECTIS_ALLOW_LISTS below.
--
-- All map files are unconditionally added; an empty file simply means no
-- hits will fire. Free-tier installs with no Pro license still ship empty
-- map files so the prefilter remains a no-op rather than failing to load.

local rspamd_logger = require "rspamd_logger"

local maps = {}
maps.block_email  = rspamd_config:add_map{ url = '/etc/rspamd/local.d/maps/block_email.map',  type = 'set', description = 'Vectis per-domain block list (email scope)' }
maps.block_domain = rspamd_config:add_map{ url = '/etc/rspamd/local.d/maps/block_domain.map', type = 'set', description = 'Vectis per-domain block list (sender domain scope)' }
maps.allow_email  = rspamd_config:add_map{ url = '/etc/rspamd/local.d/maps/allow_email.map',  type = 'set', description = 'Vectis per-domain allow list (email scope)' }
maps.allow_domain = rspamd_config:add_map{ url = '/etc/rspamd/local.d/maps/allow_domain.map', type = 'set', description = 'Vectis per-domain allow list (sender domain scope)' }

local function lookup(map, key)
  if not map then return false end
  -- rspamd `set` map: get_key returns boolean true on hit, false on miss.
  -- A non-strict truthiness check would also match every miss because
  -- `false` is not nil — so we compare for explicit `true`.
  -- Verified live on rspamd 3.10.2 during v0.1.1 → v0.1.2 fix walk.
  return map:get_key(key) == true
end

local function principal_rcpt_domain(task)
  local rcpt = task:get_principal_recipient()
  if not rcpt then return nil end
  rcpt = string.lower(rcpt)
  local at = string.find(rcpt, '@', 1, true)
  if not at then return nil end
  return string.sub(rcpt, at + 1)
end

local function smtp_from(task)
  local from = task:get_from('smtp')
  if not from or #from < 1 then return nil, nil end
  local addr = from[1].addr
  local dom = from[1].domain
  if addr then addr = string.lower(addr) end
  if dom  then dom  = string.lower(dom)  end
  return addr, dom
end

rspamd_config:register_symbol{
  name = 'VECTIS_SPAM_LISTS',
  type = 'prefilter',
  priority = 10,
  callback = function(task)
    local rcpt_domain = principal_rcpt_domain(task)
    if not rcpt_domain then return end

    local from_addr, from_domain = smtp_from(task)
    if not from_addr and not from_domain then return end

    local key_email  = from_addr   and (rcpt_domain .. ':' .. from_addr)   or nil
    local key_domain = from_domain and (rcpt_domain .. ':' .. from_domain) or nil

    -- Block list takes precedence over allow list for the same recipient.
    -- Email-scope hits take precedence over domain-scope hits within a list.
    if key_email and lookup(maps.block_email, key_email) then
      task:insert_result('VECTIS_BLOCK_EMAIL', 1.0, from_addr)
      task:set_pre_result('reject', 'Sender is on the recipient block list')
      rspamd_logger.infox(task, 'vectis: block-email hit rcpt=%s from=%s', rcpt_domain, from_addr)
      return
    end
    if key_domain and lookup(maps.block_domain, key_domain) then
      task:insert_result('VECTIS_BLOCK_DOMAIN', 1.0, from_domain)
      task:set_pre_result('reject', 'Sender domain is on the recipient block list')
      rspamd_logger.infox(task, 'vectis: block-domain hit rcpt=%s from_domain=%s', rcpt_domain, from_domain)
      return
    end
    -- NOTE: the ALLOW path deliberately does NOT live here. See
    -- VECTIS_ALLOW_LISTS below — honouring an allow entry from a prefilter
    -- bypasses antivirus and trusts a forgeable envelope.
  end,
}

-- Allow list — POSTFILTER, deliberately not a prefilter.
--
-- SECURITY (fixed 2026-08-31): this previously ran in the prefilter above and
-- called task:set_pre_result('accept'), which was wrong in two ways.
--
--   1. `accept` short-circuits the ENTIRE scan, including the CLAM_VIRUS
--      antivirus symbol. An allow entry therefore disabled malware scanning for
--      that sender, not just spam scoring.
--   2. It keyed on task:get_from('smtp') — the ENVELOPE sender, which is
--      trivially forgeable — and ran BEFORE SPF/DKIM/DMARC were evaluated,
--      because those are ordinary symbols that the `accept` skipped. Anyone
--      could set MAIL FROM to an allowlisted domain and bypass all filtering.
--
-- Now: runs as a postfilter, so authentication and antivirus have already been
-- evaluated; REQUIRES the matched identity to be authenticated; REFUSES to
-- act if a virus was found; and applies a large negative score instead of
-- accepting outright, so an allowlisted sender that later starts sending
-- malware is still caught.
--
-- Authentication required depends on which identity matched:
--   * envelope (SMTP MAIL FROM) match  -> R_SPF_ALLOW must have fired
--   * header From match                -> DMARC_POLICY_ALLOW must have fired
--
-- Matching the header From as well as the envelope also fixes a usability trap:
-- bulk senders commonly use a different bounce domain, e.g.
--   From: contacts@email.everyday.com.au
--   Return-Path: bounce-...@bounce.email.woolworthsrewards.com.au
-- so an operator allowlisting the domain they can SEE previously got silence.

local function mime_from_domain(task)
  local f = task:get_from('mime')
  if not f or #f < 1 or not f[1].domain then return nil end
  return string.lower(f[1].domain)
end

rspamd_config:register_symbol{
  name = 'VECTIS_ALLOW_LISTS',
  type = 'postfilter',
  priority = 10,
  callback = function(task)
    local rcpt_domain = principal_rcpt_domain(task)
    if not rcpt_domain then return end

    -- Never rescue a message carrying malware, whatever the list says.
    if task:get_symbol('CLAM_VIRUS') then
      rspamd_logger.infox(task, 'vectis: allow list NOT applied — CLAM_VIRUS present')
      return
    end

    local env_addr, env_domain = smtp_from(task)
    local hdr_domain = mime_from_domain(task)

    -- get_symbol returns a table on hit and nil on miss, so plain truthiness is
    -- correct here. Deliberately NOT `~= nil`: that idiom is banned in this file
    -- because for a `set` MAP get_key returns false on a miss, and `false ~= nil`
    -- is true — which would match every key. Keeping one rule avoids the trap.
    local spf_ok   = task:get_symbol('R_SPF_ALLOW')
    local dmarc_ok = task:get_symbol('DMARC_POLICY_ALLOW')

    local function hit(map, ident, authed)
      if not ident or not authed then return false end
      return lookup(map, rcpt_domain .. ':' .. ident)
    end

    local matched, why
    if hit(maps.allow_email, env_addr, spf_ok) then
      matched, why = env_addr, 'envelope address (SPF-verified)'
    elseif hit(maps.allow_domain, env_domain, spf_ok) then
      matched, why = env_domain, 'envelope domain (SPF-verified)'
    elseif hit(maps.allow_domain, hdr_domain, dmarc_ok) then
      matched, why = hdr_domain, 'header From domain (DMARC-verified)'
    end

    if not matched then
      -- Log the near-miss: an unauthenticated match is the interesting case,
      -- because silence would otherwise look identical to "not on the list".
      if (env_domain and lookup(maps.allow_domain, rcpt_domain .. ':' .. env_domain) and not spf_ok)
        or (hdr_domain and lookup(maps.allow_domain, rcpt_domain .. ':' .. hdr_domain) and not dmarc_ok) then
        rspamd_logger.infox(task, 'vectis: allow list matched but sender NOT authenticated — ignoring (rcpt=%s spf=%s dmarc=%s)',
          rcpt_domain, tostring(spf_ok), tostring(dmarc_ok))
      end
      return
    end

    task:insert_result('VECTIS_ALLOW_LIST', 1.0, matched, why)
    rspamd_logger.infox(task, 'vectis: allow hit rcpt=%s ident=%s via=%s', rcpt_domain, matched, why)
  end,
}

-- Large negative score rather than a pre-result `accept`: it clears the
-- add_header and reject thresholds for ordinary scoring, but a virus or another
-- very high-scoring signal can still carry the message over reject. Allowing is
-- a strong hint, not an override.
rspamd_config:set_metric_symbol({
  name = 'VECTIS_ALLOW_LIST',
  score = -15.0,
  description = 'Sender is on the recipient allow list and passed authentication',
})
