# Vectis Mail Server — Rspamd DKIM signing configuration
# Generated by config engine — do not edit manually
# Updated when domains are added/removed or DKIM keys are rotated (ADR-023)

allow_username_mismatch = true;

{{ range .Domains }}{{ if and .Active .DKIMEnabled .DKIMKeyPath }}domain {
    {{ .Name }} {
        selector = "{{ .DKIMSelector }}";
        path = "{{ .DKIMKeyPath }}";
    }
}
{{ end }}{{ end }}
