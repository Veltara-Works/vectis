# Vectis Mail Server — Rspamd antivirus configuration
# Generated by config engine — do not edit manually
#
{{ if eq .ClamAV.Profile "none" -}}
# clamav.profile = "none" — antivirus scanning disabled.
# (File rendered empty so the bind mount stays valid; rspamd loads no
# antivirus rules.)
{{- else -}}
# clamav.profile = {{ .ClamAV.Profile }} — rspamd dispatches every mail
# part to the vectis-clamav sidecar over TCP. A virus hit raises symbol
# CLAM_VIRUS with a high score, which crosses the reject threshold and
# postfix rejects the message at SMTP time (550 5.7.1).
clamav {
    type = "clamav";
    symbol = "CLAM_VIRUS";
    action = "reject";
    log_clean = false;
    servers = "vectis-clamav:3310";
    scan_mime_parts = true;
    scan_text_mime = false;
    scan_image_mime = false;
    timeout = 15.0;
    retransmits = 1;
    cache_expire = 86400;
}
{{- end }}
